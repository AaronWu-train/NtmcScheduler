@page "/{Workspace}/demand"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDemandService DemandService
@inject IScheduleRunService RunService
@inject ICommonConfigurationService ConfigurationService
@inject CurrentActorService CurrentActor

<PageTitle>@workspaceCode 排班</PageTitle>
<div class="page-title"><div><h1>@workspaceCode 排班</h1><p>建立並持續編輯月份 Demand，再送出背景求解。</p></div><PageHelp Title="排班與 Demand 說明"><p>Demand 是當月人員快照與 R*、X、固定班別等日格，不是每日站班人數。系統優先自動使用上月 ★ 班表；若不存在，必須上傳完整 previous schedule。Demand 會持續保存，多次求解不會覆蓋既有班表版本。</p></PageHelp></div>
@if (message is not null) { <p class="alert @messageClass" role="status">@message</p> }
<div class="toolbar"><label>月份 <input type="month" value="@monthText" @onchange="ChangeMonth" /></label><button @onclick="LoadAsync">開啟</button>@if (demand is null && canEdit) { <button class="primary" @onclick="CreateAsync">建立 Demand</button> }</div>

@if (demand is not null)
{
    <p>設定版本：<strong>v@configuration?.Version</strong>｜Previous：<strong>@(demand.PreviousSource == PreviousScheduleSource.AdoptedSchedule ? "上月 ★" : "自行上傳")</strong>｜最後儲存：@Taipei(demand.UpdatedAtUtc)</p>
    <section class="card upload-grid">
        <div><h2>Demand CSV</h2><p class="format-help">UTF-8（可含 BOM）、固定月班表表頭、日期 yyyy-MM-dd、時間 HH:mm。只接受 CSV，最大 5 MB；先預覽差異，確認後才取代。</p><a class="button-link" href="/download/templates/@Workspace.ToLowerInvariant()/demand.csv">下載範本</a>@if (canEdit) { <InputFile OnChange="PreviewDemandAsync" accept=".csv,text/csv" /> }</div>
        <div><h2>Previous schedule</h2><p class="format-help">完整上月已決定班表；不可含未解決 R*，統計欄須與日格一致。</p><a class="button-link" href="/download/templates/@Workspace.ToLowerInvariant()/previous.csv">下載範本</a>@if (canEdit) { <InputFile OnChange="UploadPreviousAsync" accept=".csv,text/csv" /> }</div>
        @if (workspaceCode == WorkspaceCode.M) { <div><h2>M 八週萬年班表</h2><p class="format-help">表頭為萬年班表,1..56；格值只接受空白、R 或合法 M 站班。</p><a class="button-link" href="/download/templates/m/perpetual.csv">下載範本</a>@if (canEdit) { <InputFile OnChange="UploadPerpetualAsync" accept=".csv,text/csv" /> }</div> }
    </section>
    @if (preview is not null)
    {
        <section class="card"><h2>匯入預覽</h2>@foreach (var error in preview.Errors) { <p class="error-text">@error</p> }@foreach (var difference in preview.Differences) { <p>@difference</p> }@if (preview.IsValid) { <button class="primary" @onclick="ConfirmDemandImportAsync">確認取代 Demand</button> } <button @onclick="CancelPreview">取消</button></section>
    }

    <section class="card">
        <div class="section-heading"><h2>月份人員資料</h2><span>日格點選後立即自動儲存</span></div>
        <div class="table-scroll schedule-grid"><table><thead><tr><th class="sticky-col">員工</th>@foreach (var day in Days()) { <th>@day.Day<br /><small>@Weekday(day)</small></th> }<th>月初 R</th><th>月初 R1</th><th>R休上限</th>@if (workspaceCode == WorkspaceCode.T) { <th>月班別</th> }<th>設定</th></tr></thead><tbody>
        @foreach (var employee in demand.Employees)
        {
            <tr><th class="sticky-col">@employee.EmployeeCode<br /><small>@employee.Name</small></th>
            @foreach (var day in Days())
            {
                var cell = employee.Assignments.FirstOrDefault(x => x.Date == day);
                <td><button class="cell @CellClass(cell)" title="@CellText(cell)" disabled="@(!canEdit)" @onclick="() => OpenCell(employee, day, cell)">@CellText(cell)</button></td>
            }
            <td>@employee.OpeningRest</td><td>@employee.OpeningSpecialRest</td><td>@employee.RequestedLeaveRestCount</td>@if (workspaceCode == WorkspaceCode.T) { <td>@ShiftLabel(employee.MonthlyShift)</td> }<td>@if (canEdit) { <button @onclick="() => OpenEmployee(employee)">編輯</button> }</td></tr>
        }
        </tbody></table></div>
    </section>
    <div class="toolbar">@if (canEdit) { <button class="primary" @onclick="QueueAsync">執行求解</button> }<button @onclick="LoadRunsAsync">更新狀態</button></div>
    <div class="table-scroll"><table><thead><tr><th>建立時間</th><th>狀態</th><th>完成時間</th><th>訊息</th></tr></thead><tbody>@foreach (var run in runs) { <tr><td>@Taipei(run.CreatedAtUtc)</td><td>@run.Status</td><td>@(run.CompletedAtUtc is null ? "" : Taipei(run.CompletedAtUtc.Value))</td><td>@run.Error</td></tr> }</tbody></table></div>
}

@if (editingEmployee is not null)
{
    <div class="modal-backdrop"></div><section class="editor-dialog" role="dialog" aria-modal="true"><h2>@editingEmployee.EmployeeCode 月份資料</h2>
    <label>月初 R<input type="number" min="0" @bind="employeeEdit.OpeningRest" /></label><label>月初 R1<input type="number" min="0" @bind="employeeEdit.OpeningSpecialRest" /></label><label>R休上限<input type="number" min="0" @bind="employeeEdit.LeaveRest" /></label>
    @if (workspaceCode == WorkspaceCode.T) { <label>月班別<select @bind="employeeEdit.MonthlyShift"><option value="Early">早</option><option value="Afternoon">午</option><option value="Night">夜</option></select></label> }
    @if (workspaceCode == WorkspaceCode.M) { <label>萬年班表代號<input @bind="employeeEdit.PerpetualId" /></label> }
    <div class="toolbar"><button class="primary" @onclick="SaveEmployeeAsync">儲存</button><button @onclick="CloseEditors">取消</button></div></section>
}
@if (editingCellEmployee is not null)
{
    <div class="modal-backdrop"></div><section class="editor-dialog" role="dialog" aria-modal="true"><h2>@editingCellEmployee.EmployeeCode／@editingDate.ToString("yyyy-MM-dd")</h2>
    <label>狀態<select @bind="cellEdit.Kind"><option value="">空白（交由求解）</option><option value="Unresolved">R*</option><option value="Rest">R</option><option value="SpecialRest">R1</option><option value="LeaveRest">R*[R休]</option><option value="Work">正常班</option><option value="WorkEvent">X</option></select></label>
    @if (cellEdit.Kind is "Rest" or "SpecialRest") { <label><input type="checkbox" @bind="cellEdit.RequestedRest" /> 保留 R* 標記</label> }
    @if (cellEdit.Kind == "Work") { <label>班別<select @bind="cellEdit.Shift"><option value="Early">早</option><option value="Afternoon">@(workspaceCode == WorkspaceCode.M ? "小" : "午")</option><option value="Night">夜</option></select></label>@if (workspaceCode == WorkspaceCode.M) { <label>車站<select @bind="cellEdit.Station">@foreach (var station in MStations) { <option>@station</option> }</select></label> } }
    @if (cellEdit.Kind == "WorkEvent") { <label>常用班型<select @onchange="ApplyNonStandard"><option value="">自行輸入</option>@foreach (var shift in configuration?.NonStandardShifts ?? []) { <option value="@shift.Code">@(shift.Name ?? shift.Code)（@(shift.StartTime.ToString("HH:mm"))–@(shift.EndTime.ToString("HH:mm"))）</option> }</select></label><label>開始<input type="datetime-local" @bind="cellEdit.Start" /></label><label>結束<input type="datetime-local" @bind="cellEdit.End" /></label><label>說明<input maxlength="500" @bind="cellEdit.Description" /></label> }
    <div class="toolbar"><button class="primary" @onclick="SaveCellAsync">儲存</button><button @onclick="CloseEditors">取消</button></div></section>
}

@code {
    [Parameter] public string Workspace { get; set; } = "";
    private static readonly string[] MStations = Enumerable.Range(1, 12).Select(x => $"LB{x:D2}").ToArray();
    private WorkspaceCode workspaceCode; private string monthText = DateTime.Today.ToString("yyyy-MM"); private bool canEdit;
    private DemandDraftDto? demand; private ConfigurationRevisionDto? configuration; private IReadOnlyList<ScheduleRunDto> runs = [];
    private string? message; private string messageClass = "success"; private byte[]? pendingDemand; private ImportPreviewDto? preview;
    private DemandEmployeeDto? editingEmployee; private readonly EmployeeEdit employeeEdit = new();
    private DemandEmployeeDto? editingCellEmployee; private DateOnly editingDate; private readonly CellEdit cellEdit = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<WorkspaceCode>(Workspace, true, out workspaceCode)) throw new DomainValidationException("工作區只支援 M 或 T。");
        var actor = await CurrentActor.GetAsync(); canEdit = actor.CanEdit(workspaceCode) && !actor.MustChangePassword; await LoadAsync();
    }
    private DateOnly Month() => DateOnly.ParseExact(monthText + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture);
    private void ChangeMonth(ChangeEventArgs args) => monthText = args.Value?.ToString() ?? monthText;
    private async Task LoadAsync()
    {
        var actor = await CurrentActor.GetAsync(); demand = await DemandService.GetAsync(workspaceCode, Month(), actor); configuration = demand is null ? null : await ConfigurationService.GetRevisionAsync(demand.ConfigurationRevisionId, actor); await LoadRunsAsync();
    }
    private async Task CreateAsync() => await RunUiAsync(async () => { var actor = await CurrentActor.GetAsync(); demand = await DemandService.CreateAsync(workspaceCode, Month(), actor); configuration = await ConfigurationService.GetRevisionAsync(demand.ConfigurationRevisionId, actor); }, "Demand 已建立。");
    private IEnumerable<DateOnly> Days() => Enumerable.Range(0, DateTime.DaysInMonth(Month().Year, Month().Month)).Select(Month().AddDays);
    private static string Weekday(DateOnly date) => "日一二三四五六"[(int)date.DayOfWeek].ToString();
    private async Task LoadRunsAsync() => runs = await RunService.ListAsync(workspaceCode, Month(), await CurrentActor.GetAsync());
    private async Task QueueAsync() => await RunUiAsync(async () => { await RunService.QueueAsync(demand!.Id, demand.RevisionToken, await CurrentActor.GetAsync()); await LoadRunsAsync(); }, "已排入背景求解佇列。");

    private async Task PreviewDemandAsync(InputFileChangeEventArgs args) => await RunUiAsync(async () => { pendingDemand = await ReadFileAsync(args.File); preview = await DemandService.PreviewDemandImportAsync(demand!.Id, new MemoryStream(pendingDemand), await CurrentActor.GetAsync()); }, "已完成匯入預覽。");
    private async Task ConfirmDemandImportAsync() => await RunUiAsync(async () => { await DemandService.ImportDemandAsync(demand!.Id, new MemoryStream(pendingDemand!), demand.RevisionToken, await CurrentActor.GetAsync()); CancelPreview(); await LoadAsync(); }, "Demand 已由 CSV 取代。");
    private async Task UploadPreviousAsync(InputFileChangeEventArgs args) => await RunUiAsync(async () => { var bytes = await ReadFileAsync(args.File); await DemandService.UploadPreviousAsync(demand!.Id, new MemoryStream(bytes), demand.RevisionToken, await CurrentActor.GetAsync()); await LoadAsync(); }, "Previous schedule 已保存。");
    private async Task UploadPerpetualAsync(InputFileChangeEventArgs args) => await RunUiAsync(async () => { var bytes = await ReadFileAsync(args.File); await DemandService.UploadPerpetualScheduleAsync(demand!.Id, new MemoryStream(bytes), demand.RevisionToken, await CurrentActor.GetAsync()); await LoadAsync(); }, "萬年班表已保存。");
    private static async Task<byte[]> ReadFileAsync(IBrowserFile file) { await using var stream = file.OpenReadStream(5 * 1024 * 1024); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); return memory.ToArray(); }
    private void CancelPreview() { pendingDemand = null; preview = null; }

    private void OpenEmployee(DemandEmployeeDto employee) { editingEmployee = employee; employeeEdit.MonthlyShift = employee.MonthlyShift ?? "Early"; employeeEdit.OpeningRest = employee.OpeningRest; employeeEdit.OpeningSpecialRest = employee.OpeningSpecialRest; employeeEdit.LeaveRest = employee.RequestedLeaveRestCount; employeeEdit.PerpetualId = employee.PerpetualScheduleId ?? ""; }
    private async Task SaveEmployeeAsync() => await RunUiAsync(async () => { demand = await DemandService.UpdateEmployeeAsync(editingEmployee!.Id, workspaceCode == WorkspaceCode.T ? employeeEdit.MonthlyShift : null, employeeEdit.OpeningRest, employeeEdit.OpeningSpecialRest, employeeEdit.LeaveRest, employeeEdit.PerpetualId, demand!.RevisionToken, await CurrentActor.GetAsync()); CloseEditors(); }, "月份員工資料已儲存。");
    private void OpenCell(DemandEmployeeDto employee, DateOnly date, DemandAssignmentDto? cell) { editingCellEmployee = employee; editingDate = date; cellEdit.Kind = cell?.Kind ?? (cell?.RequestedRest == true ? "Unresolved" : ""); cellEdit.RequestedRest = cell?.RequestedRest ?? false; cellEdit.Station = cell?.Station ?? employee.Affiliation; cellEdit.Shift = cell?.Shift ?? "Early"; cellEdit.Start = LocalText(cell?.EventStart); cellEdit.End = LocalText(cell?.EventEnd); cellEdit.Description = cell?.EventDescription ?? ""; }
    private async Task SaveCellAsync() => await RunUiAsync(async () => { var requested = cellEdit.Kind == "Unresolved" || cellEdit.Kind == "LeaveRest" || cellEdit.RequestedRest; demand = await DemandService.UpdateAssignmentAsync(editingCellEmployee!.Id, editingDate, cellEdit.Kind == "Unresolved" ? null : cellEdit.Kind, requested, workspaceCode == WorkspaceCode.M ? cellEdit.Station : null, cellEdit.Shift, Offset(cellEdit.Start), Offset(cellEdit.End), cellEdit.Description, demand!.RevisionToken, await CurrentActor.GetAsync()); CloseEditors(); }, "日格已自動儲存。");
    private void ApplyNonStandard(ChangeEventArgs args) { var shift = configuration?.NonStandardShifts.FirstOrDefault(x => x.Code == args.Value?.ToString()); if (shift is null) return; var endDate = shift.EndTime <= shift.StartTime ? editingDate.AddDays(1) : editingDate; cellEdit.Start = editingDate.ToDateTime(shift.StartTime); cellEdit.End = endDate.ToDateTime(shift.EndTime); }
    private static DateTimeOffset? Offset(DateTime? value) => value is null ? null : new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified), TimeSpan.FromHours(8));
    private static DateTime? LocalText(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(8)).DateTime;
    private void CloseEditors() { editingEmployee = null; editingCellEmployee = null; }

    private async Task RunUiAsync(Func<Task> action, string success) { try { await action(); messageClass = "success"; message = success; } catch (Exception exception) { messageClass = "error"; message = exception.Message; } }
    private static string CellText(DemandAssignmentDto? cell) => cell switch { null => "", { Kind: null, RequestedRest: true } => "R*", { Kind: "Rest", RequestedRest: true } => "R*[R]", { Kind: "SpecialRest", RequestedRest: true } => "R*[R1]", { Kind: "LeaveRest" } => "R*[R休]", { Kind: "Rest" } => "R", { Kind: "SpecialRest" } => "R1", { Kind: "WorkEvent" } => "X", { Kind: "Work", Shift: "Early" } => "早", { Kind: "Work", Shift: "Afternoon" } => "午/小", { Kind: "Work", Shift: "Night" } => "夜", _ => "" };
    private static string CellClass(DemandAssignmentDto? cell) => cell?.Kind switch { "Rest" or "SpecialRest" or "LeaveRest" => "rest", "Work" when cell.Shift == "Early" => "early", "Work" when cell.Shift == "Afternoon" => "afternoon", "Work" when cell.Shift == "Night" => "night", "WorkEvent" => "event", _ => cell?.RequestedRest == true ? "requested" : "" };
    private static string ShiftLabel(string? shift) => shift switch { "Early" => "早", "Afternoon" => "午", "Night" => "夜", _ => "" };
    private static string Taipei(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm");
    private sealed class EmployeeEdit { public string MonthlyShift { get; set; } = "Early"; public int? OpeningRest { get; set; } public int? OpeningSpecialRest { get; set; } public int LeaveRest { get; set; } public string PerpetualId { get; set; } = ""; }
    private sealed class CellEdit { public string Kind { get; set; } = ""; public bool RequestedRest { get; set; } public string Station { get; set; } = "LB01"; public string Shift { get; set; } = "Early"; public DateTime? Start { get; set; } public DateTime? End { get; set; } public string Description { get; set; } = ""; }
}

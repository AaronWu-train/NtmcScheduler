@page "/runs/{Id:long}/candidates"
@rendermode InteractiveServer
@inject ICandidateService CandidatesSvc
@inject IScheduleRunService Runs
@inject IScheduleService Schedules
@inject OperatorState Operator
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>候選比較</PageTitle>

<h1 class="h3 mb-3">Run #@Id 候選比較</h1>

<p class="text-muted">選擇一份候選後立即成為該單位該月份的「目前班表」；若已有目前班表會先確認是否取代。</p>

<MetricsCompareTable Compare="_compare" OnPromote="SelectAsync" PromoteLabel="選為目前班表" />

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info mt-3">@_message</div>
}

@code {
    [Parameter] public long Id { get; set; }

    private CandidateCompareDto? _compare;
    private RunSummaryDto? _run;
    private string? _message;

    protected override async Task OnParametersSetAsync()
    {
        _compare = await CandidatesSvc.CompareAsync(Id);
        _run = (await Runs.ListAsync()).FirstOrDefault(r => r.Id == Id);
    }

    private async Task SelectAsync(long candidateId)
    {
        try
        {
            if (_run is not null && await Schedules.ExistsAsync(_run.Unit, _run.TargetMonth))
            {
                var ok = await Js.InvokeAsync<bool>("confirm",
                    $"已有 {_run.Unit} {_run.TargetMonth} 的目前班表，確定要以候選取代？");
                if (!ok) return;
            }

            await Schedules.SelectCandidateAsync(candidateId, Operator.Name);
            if (_run is not null)
                Nav.NavigateTo($"schedules/{_run.Unit}/{_run.TargetMonth}");
            else
                _message = "已選為目前班表";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }
}

@page "/runs"
@rendermode InteractiveServer
@inject IScheduleRunService RunsSvc
@inject OperatorState Operator
@inject NavigationManager Nav

<PageTitle>求解 Run</PageTitle>

<h1 class="h3 mb-3">求解 Run</h1>

<div class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">單位</label>
            <select class="form-select" @bind="_unit">
                <option value="@Unit.M">M</option>
                <option value="@Unit.T">T</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">目標月</label>
            <input class="form-control" type="month" value="@_monthInput" @onchange="OnMonthChanged" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="CreateAsync">建立 Run</button>
        </div>
    </div>
</div>

@if (_createErrors.Count > 0)
{
    <div class="alert alert-danger">
        <div class="fw-semibold">INVALID_INPUT — 未建立 Run</div>
        <ul class="mb-0">
            @foreach (var e in _createErrors)
            {
                <li><code>@e.Code</code> @e.Message</li>
            }
        </ul>
    </div>
}

<table class="table table-sm table-hover">
    <thead>
        <tr>
            <th>ID</th><th>單位</th><th>月份</th><th>狀態</th>
            <th>Schedule</th><th>Optimization</th><th>候選</th><th>操作者</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in _list)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Unit</td>
                <td>@r.TargetMonth</td>
                <td><span class="badge text-bg-secondary">@r.Status</span></td>
                <td>@(r.ScheduleStatus?.ToString() ?? "-")</td>
                <td>@(r.OptimizationStatus?.ToString() ?? "-")</td>
                <td>@r.CandidateCount</td>
                <td>@r.Operator</td>
                <td><a href="@($"runs/{r.Id}")">詳情</a></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Unit _unit = Unit.M;
    private string _monthInput = $"{DateTime.Today:yyyy-MM}";
    private IReadOnlyList<RunSummaryDto> _list = Array.Empty<RunSummaryDto>();
    private List<ValidationError> _createErrors = [];

    protected override async Task OnInitializedAsync() =>
        _list = await RunsSvc.ListAsync();

    private async Task CreateAsync()
    {
        var result = await RunsSvc.CreateAsync(_unit, YearMonth.Parse(_monthInput), Operator.Name);
        if (!result.Succeeded)
        {
            _createErrors = result.Errors.ToList();
            return;
        }

        _createErrors.Clear();
        Nav.NavigateTo($"runs/{result.RunId}");
    }

    private void OnMonthChanged(ChangeEventArgs e)
    {
        _monthInput = e.Value?.ToString() ?? _monthInput;
    }

}

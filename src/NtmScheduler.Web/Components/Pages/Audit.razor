@page "/audit"
@rendermode InteractiveServer
@inject IAuditService AuditSvc

<PageTitle>稽核紀錄</PageTitle>

<h1 class="h3 mb-3">稽核紀錄</h1>

<div class="row g-2 mb-3">
    <div class="col-md-2">
        <input class="form-control" placeholder="操作者" @bind="_operator" />
    </div>
    <div class="col-md-2">
        <input class="form-control" placeholder="動作" @bind="_action" />
    </div>
    <div class="col-md-2">
        <input class="form-control" type="datetime-local" @bind="_from" />
    </div>
    <div class="col-md-2">
        <input class="form-control" type="datetime-local" @bind="_to" />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="SearchAsync">查詢</button>
    </div>
</div>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>時間</th><th>操作者</th><th>動作</th>
            <th>對象</th><th>Before</th><th>After</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in _rows)
        {
            <tr>
                <td>@a.At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@a.Operator</td>
                <td>@a.Action</td>
                <td>@a.TargetType #@a.TargetId</td>
                <td class="small" style="max-width:12rem; overflow:hidden; text-overflow:ellipsis;">@(a.BeforeJson ?? "")</td>
                <td class="small" style="max-width:12rem; overflow:hidden; text-overflow:ellipsis;">@(a.AfterJson ?? "")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string? _operator;
    private string? _action;
    private DateTime? _from;
    private DateTime? _to;
    private IReadOnlyList<AuditLogDto> _rows = Array.Empty<AuditLogDto>();

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        _rows = await AuditSvc.QueryAsync(new AuditQuery(
            Operator: _operator,
            Action: _action,
            From: _from,
            To: _to,
            Take: 200));
    }
}

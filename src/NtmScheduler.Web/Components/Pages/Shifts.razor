@page "/employees/shifts"
@rendermode InteractiveServer
@inject IEmployeeService EmployeesSvc
@inject IMonthlyShiftService ShiftsSvc
@inject OperatorState Operator

<PageTitle>T 月班組</PageTitle>

<h1 class="h3 mb-3">T 月班組</h1>
<p class="text-muted">依月維護檢測單位班組（早／午／夜）；可覆寫輪轉建議值。</p>

<div class="row g-3 mb-3">
    <div class="col-auto">
        <label class="form-label">月份</label>
        <input class="form-control" type="month" value="@_monthInput" @onchange="OnMonthChanged" />
    </div>
    <div class="col-auto d-flex align-items-end">
        <InputFile OnChange="OnImport" accept=".csv" class="form-control" />
    </div>
</div>

@if (_importResult is not null)
{
    <div class="alert alert-info small">
        匯入成功 @_importResult.SuccessCount；錯誤 @_importResult.Errors.Count
    </div>
}

<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>員工</th><th>姓名</th><th>建議（輪轉）</th><th>實際班組</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in _employees)
        {
            var current = _shifts.TryGetValue(e.Id, out var s) ? s : (ShiftType?)null;
            <tr>
                <td>@e.Id</td>
                <td>@e.Name</td>
                <td class="text-muted">—</td>
                <td>
                    <select class="form-select form-select-sm"
                            value="@(current?.ToDisplay() ?? "")"
                            @onchange="ev => OnChangeAsync(e.Id, ev)">
                        <option value="">（未設定）</option>
                        <option value="早">早</option>
                        <option value="午">午</option>
                        <option value="夜">夜</option>
                    </select>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string _monthInput = $"{DateTime.Today:yyyy-MM}";
    private IReadOnlyList<EmployeeInfo> _employees = Array.Empty<EmployeeInfo>();
    private IReadOnlyDictionary<string, ShiftType> _shifts = new Dictionary<string, ShiftType>();
    private ImportResult? _importResult;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var month = YearMonth.Parse(_monthInput);
        _employees = await EmployeesSvc.ListAsync(Unit.T);
        _shifts = await ShiftsSvc.GetMonthAsync(month);
    }

    private async Task OnChangeAsync(string empId, ChangeEventArgs e)
    {
        var month = YearMonth.Parse(_monthInput);
        var text = e.Value?.ToString();
        if (string.IsNullOrEmpty(text))
        {
            await ShiftsSvc.DeleteAsync(empId, month, Operator.Name);
        }
        else
        {
            await ShiftsSvc.UpsertAsync(empId, month, ShiftTypeExtensions.ParseDisplay(text), Operator.Name);
        }
        await ReloadAsync();
    }

    private async Task OnImport(InputFileChangeEventArgs e)
    {
        await using var stream = e.File.OpenReadStream(5_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;
        _importResult = await ShiftsSvc.ImportCsvAsync(ms, Operator.Name);
        await ReloadAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        _monthInput = e.Value?.ToString() ?? _monthInput;
        await ReloadAsync();
    }

}

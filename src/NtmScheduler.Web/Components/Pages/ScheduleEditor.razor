@page "/schedules/{UnitCode}/{MonthKey}"
@rendermode InteractiveServer
@inject IScheduleService Schedules
@inject OperatorState Operator
@inject IJSRuntime Js

<PageTitle>目前班表 @UnitCode @MonthKey</PageTitle>

<h1 class="h3 mb-3">目前班表 — @UnitCode @MonthKey</h1>

@if (_missing)
{
    <div class="alert alert-secondary">
        此單位／月份尚無目前班表。請至
        <a href="runs">求解 Run</a> 產生候選後選為目前班表。
    </div>
}
else
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <button class="btn btn-outline-secondary btn-sm" @onclick="UndoAsync">復原</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="RevalidateAsync">重新驗證</button>
        <button class="btn btn-outline-primary btn-sm" @onclick="SnapshotAsync">建立快照</button>
        @if (_validation is not null)
        {
            <span class="badge @(_validation.P0Passed ? "text-bg-success" : "text-bg-danger")">
                P0 @(_validation.P0Passed ? "通過" : "未通過")
            </span>
        }
        @if (_scheduleId is { } sid)
        {
            <span class="text-muted small">班表 #@sid</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info">@_message</div>
    }

    <CellEditorPopover Visible="_editorOpen"
                       EmployeeId="_editEmp"
                       Date="_editDate"
                       Options="_options"
                       OnClose="() => _editorOpen = false"
                       OnSelected="ApplyAsync" />

    <WideTable Table="_table"
               HighlightEmployeeId="_highlightEmp"
               HighlightDate="_highlightDate"
               CellSelected="OpenEditorAsync" />

    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <ViolationPanel Violations="_validation?.Violations" OnJump="OnJump" />
        </div>
        <div class="col-md-6">
            <CoveragePanel MCoverage="_validation?.MCoverage"
                           TCoverage="_validation?.TCoverage"
                           RestStatsRows="_restRows" />
        </div>
    </div>
}

@code {
    [Parameter] public string UnitCode { get; set; } = "M";
    [Parameter] public string MonthKey { get; set; } = "";

    private long? _scheduleId;
    private bool _missing;
    private WideTableDto? _table;
    private ScheduleValidationDto? _validation;
    private IReadOnlyList<(string Id, string Name, RestStatsDto Stats)>? _restRows;

    private bool _editorOpen;
    private string? _editEmp;
    private DateOnly _editDate;
    private IReadOnlyList<CellOptionDto>? _options;

    private string? _highlightEmp;
    private DateOnly? _highlightDate;
    private string? _message;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _missing = false;
        _message = null;
        if (!Enum.TryParse<Unit>(UnitCode, ignoreCase: true, out var unit))
        {
            _missing = true;
            return;
        }

        YearMonth month;
        try { month = YearMonth.Parse(MonthKey); }
        catch
        {
            _missing = true;
            return;
        }

        _table = await Schedules.GetCurrentAsync(unit, month);
        if (_table is null)
        {
            _missing = true;
            _validation = null;
            _scheduleId = null;
            return;
        }

        _scheduleId = _table.OwnerId;
        if (_scheduleId is { } id)
            _validation = await Schedules.RevalidateAsync(id);
        _restRows = _table.Rows
            .Where(r => r.RestStats is not null)
            .Select(r => (r.EmployeeId, r.EmployeeName, r.RestStats!))
            .ToList();
    }

    private async Task OpenEditorAsync((string EmployeeId, DateOnly Date) cell)
    {
        if (_scheduleId is null) return;
        _editEmp = cell.EmployeeId;
        _editDate = cell.Date;
        _options = await Schedules.GetCellOptionsAsync(_scheduleId.Value, cell.EmployeeId, cell.Date);
        _editorOpen = true;
    }

    private async Task ApplyAsync(CellOptionDto opt)
    {
        if (_editEmp is null || _scheduleId is null) return;
        _validation = await Schedules.ApplyEditAsync(_scheduleId.Value, _editEmp, _editDate, opt.State, Operator.Name);
        _editorOpen = false;
        _table = await Schedules.GetAsync(_scheduleId.Value);
        _restRows = _table.Rows
            .Where(r => r.RestStats is not null)
            .Select(r => (r.EmployeeId, r.EmployeeName, r.RestStats!))
            .ToList();
    }

    private async Task UndoAsync()
    {
        if (_scheduleId is null) return;
        try
        {
            _validation = await Schedules.UndoAsync(_scheduleId.Value, Operator.Name);
            _table = await Schedules.GetAsync(_scheduleId.Value);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task RevalidateAsync()
    {
        if (_scheduleId is null) return;
        _validation = await Schedules.RevalidateAsync(_scheduleId.Value);
    }

    private async Task SnapshotAsync()
    {
        if (_scheduleId is null) return;
        try
        {
            var id = await Schedules.CreateSnapshotAsync(_scheduleId.Value, Operator.Name);
            _message = $"已建立快照 #{id}";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task OnJump((string? EmployeeId, DateOnly? Date, string RuleId) target)
    {
        _highlightEmp = target.EmployeeId;
        _highlightDate = target.Date;
        if (target.EmployeeId is not null && target.Date is { } d)
        {
            var id = $"cell-{target.EmployeeId}-{d:yyyyMMdd}";
            try
            {
                await Js.InvokeVoidAsync("eval",
                    $"document.getElementById('{id}')?.scrollIntoView({{block:'center', inline:'center'}})");
            }
            catch (JSException)
            {
            }
        }
    }
}

@page "/import"
@rendermode InteractiveServer
@inject IHistoryImportService History
@inject IEmployeeService Employees
@inject OperatorState Operator
@inject IJSRuntime Js

<PageTitle>CSV 批次工具</PageTitle>

<h1 class="h3 mb-3">CSV 批次工具（選用）</h1>

<div class="alert alert-info">
    <strong>一般排班不需要 CSV。</strong>
    人員、R*、X 都可在網頁直接輸入；歷史由系統讀取先前班表。
    本頁僅供批次匯入／匯出。UTF-8（建議含 BOM）。
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(_tab == "emp" ? "active" : null)" @onclick='() => _tab = "emp"'>人員資料</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == "sched" ? "active" : null)" @onclick='() => _tab = "sched"'>寬表班表（歷史）</button>
    </li>
</ul>

@if (_tab == "emp")
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">人員資料 CSV</h2>
            <p class="small">用途：一次匯入多位站務或檢測人員。匯入後仍可在「人員管理」頁修改。</p>

            <h3 class="h6">站務 M — 欄位</h3>
            <table class="table table-sm table-bordered w-auto">
                <thead><tr><th>欄位</th><th>說明</th><th>範例</th></tr></thead>
                <tbody>
                    <tr><td><code>employee_id</code></td><td>員工編號（唯一）</td><td>M001</td></tr>
                    <tr><td><code>name</code></td><td>姓名</td><td>王小明</td></tr>
                    <tr><td><code>home_station</code></td><td>所屬車站 LB01–LB12</td><td>LB01</td></tr>
                </tbody>
            </table>
            <pre class="bg-light p-2 small">employee_id,name,home_station
M001,王小明,LB01</pre>

            <h3 class="h6">檢測 T — 欄位</h3>
            <table class="table table-sm table-bordered w-auto">
                <thead><tr><th>欄位</th><th>說明</th><th>範例</th></tr></thead>
                <tbody>
                    <tr><td><code>employee_id</code></td><td>員工編號</td><td>T001</td></tr>
                    <tr><td><code>name</code></td><td>姓名</td><td>陳大同</td></tr>
                    <tr><td><code>specialty</code></td><td>專業（可空白）</td><td>軌道</td></tr>
                    <tr><td><code>ability</code></td><td>能力 1～5</td><td>3</td></tr>
                </tbody>
            </table>
            <pre class="bg-light p-2 small">employee_id,name,specialty,ability
T001,陳大同,軌道,3</pre>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlMTemplate()">下載 M 空白範本</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlMExample()">下載 M 完整範例</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlTTemplate()">下載 T 空白範本</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlTExample()">下載 T 完整範例</button>
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">單位</label>
                    <select class="form-select" @bind="_empUnit">
                        <option value="@Unit.M">站務 M</option>
                        <option value="@Unit.T">檢測 T</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label">選擇 CSV</label>
                    <InputFile OnChange="OnEmpFile" accept=".csv" />
                </div>
            </div>

            @if (_empPreview is not null)
            {
                <div class="mt-3">
                    <div class="fw-semibold">預覽（前 @_empPreview.Count 列）</div>
                    <pre class="bg-light p-2 small" style="max-height:12rem;overflow:auto;">@string.Join('\n', _empPreview)</pre>
                    <button class="btn btn-primary" @onclick="ConfirmEmpImportAsync">確認匯入</button>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">寬表班表 CSV（歷史匯入）</h2>
            <p class="small">
                用途：初次上線或補歷史時，匯入過去月份的寬表。
                <code>R1</code>／<code>R*</code> 必須原樣保留，不可改成 <code>R</code>。
                若歷史含 X，請一併附上 events.csv。
            </p>

            <h3 class="h6">schedule.csv 欄位</h3>
            <ul class="small">
                <li><code>employee_id,name,home_station</code>（M）或 <code>employee_id,name,shift</code>（T）</li>
                <li>其後每個日期一欄，例如 <code>2026-07-01</code>，內容為 <code>早</code>／<code>午</code>／<code>夜</code>／<code>R</code>／<code>R*</code>／<code>R1</code>／<code>X</code>／跨站 <code>LB02-午</code></li>
                <li>結尾統計欄（僅顯示）：<code>month_r,month_r1,cycle_r,cycle_r1</code></li>
            </ul>
            <pre class="bg-light p-2 small">employee_id,name,home_station,2026-07-01,2026-07-02,month_r,month_r1,cycle_r,cycle_r1
M001,王小明,LB01,早,R,1,0,1,0</pre>

            <h3 class="h6">events.csv 欄位（選填）</h3>
            <pre class="bg-light p-2 small">employee_id,type,date,start,end,description
M001,R*,2026-07-02,,,指定休假
M002,X,,2026-07-05T09:00:00,2026-07-05T17:00:00,訓練</pre>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlSchedTemplate()">下載空白範本</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlSchedExample()">下載完整範例</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => DlEventsExample()">下載 events 範例</button>
            </div>

            <div class="mb-3">
                <label class="form-label">schedule.csv（必填）</label>
                <InputFile OnChange="OnSchedule" accept=".csv" />
                @if (_scheduleName is not null)
                {
                    <div class="small text-success">已選：@_scheduleName</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">events.csv（選填）</label>
                <InputFile OnChange="OnEvents" accept=".csv" />
                @if (_eventsName is not null)
                {
                    <div class="small text-success">已選：@_eventsName</div>
                }
            </div>

            @if (_schedPreview is not null)
            {
                <div class="mb-2">
                    <div class="fw-semibold">預覽（前幾列）</div>
                    <pre class="bg-light p-2 small" style="max-height:12rem;overflow:auto;">@_schedPreview</pre>
                </div>
            }

            <button class="btn btn-primary" disabled="@(_scheduleBytes is null)" @onclick="ImportScheduleAsync">確認匯入歷史</button>
        </div>
    </div>
}

@if (_result is not null)
{
    <div class="alert @(_result.Errors.Count == 0 ? "alert-success" : "alert-warning")">
        成功 @_result.SuccessCount 筆；錯誤 @_result.Errors.Count
        <ul class="mb-0">
            @foreach (var e in _result.Errors.Take(30))
            {
                <li>
                    @(e.Row is { } row ? $"第 {row} 列：" : "")@e.Message
                    @(e.EmployeeId is null ? "" : $"（員工 {e.EmployeeId}）")
                </li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-danger">@_message</div>
}

@code {
    private string _tab = "emp";
    private Unit _empUnit = Unit.M;
    private string? _message;
    private ImportResult? _result;

    private byte[]? _empBytes;
    private List<string>? _empPreview;

    private byte[]? _scheduleBytes;
    private byte[]? _eventsBytes;
    private string? _scheduleName;
    private string? _eventsName;
    private string? _schedPreview;

    private const string MTemplate = "employee_id,name,home_station\n";
    private const string MExample = "employee_id,name,home_station\nM001,王小明,LB01\nM002,李美華,LB01\n";
    private const string TTemplate = "employee_id,name,specialty,ability\n";
    private const string TExample = "employee_id,name,specialty,ability\nT001,陳大同,軌道,3\nT002,林小芳,號誌,4\n";
    private const string ScheduleTemplate = "employee_id,name,home_station,2026-07-01,2026-07-02,month_r,month_r1,cycle_r,cycle_r1\n";
    private const string ScheduleExample = "employee_id,name,home_station,2026-07-01,2026-07-02,month_r,month_r1,cycle_r,cycle_r1\nM001,王小明,LB01,早,R,1,0,1,0\n";
    private const string EventsExample = "employee_id,type,date,start,end,description\nM001,R*,2026-07-02,,,指定休假\nM002,X,,2026-07-05T09:00:00,2026-07-05T17:00:00,訓練\n";

    private async Task OnEmpFile(InputFileChangeEventArgs e)
    {
        _empBytes = await ReadAsync(e.File);
        _empPreview = System.Text.Encoding.UTF8.GetString(_empBytes)
            .Split('\n').Select(s => s.TrimEnd('\r')).Where(s => s.Length > 0).Take(8).ToList();
        _result = null;
        _message = null;
    }

    private async Task ConfirmEmpImportAsync()
    {
        if (_empBytes is null) return;
        try
        {
            await using var ms = new MemoryStream(_empBytes);
            _result = await Employees.ImportCsvAsync(_empUnit, ms, Operator.Name);
            _message = null;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _result = null;
        }
    }

    private async Task OnSchedule(InputFileChangeEventArgs e)
    {
        _scheduleName = e.File.Name;
        _scheduleBytes = await ReadAsync(e.File);
        _schedPreview = string.Join('\n',
            System.Text.Encoding.UTF8.GetString(_scheduleBytes)
                .Split('\n').Select(s => s.TrimEnd('\r')).Where(s => s.Length > 0).Take(6));
        _result = null;
    }

    private async Task OnEvents(InputFileChangeEventArgs e)
    {
        _eventsName = e.File.Name;
        _eventsBytes = await ReadAsync(e.File);
    }

    private async Task ImportScheduleAsync()
    {
        if (_scheduleBytes is null) return;
        await using var schedule = new MemoryStream(_scheduleBytes);
        Stream? events = _eventsBytes is null ? null : new MemoryStream(_eventsBytes);
        try
        {
            _result = await History.ImportAsync(schedule, events, Operator.Name);
            _message = null;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _result = null;
        }
        finally
        {
            if (events is not null)
                await events.DisposeAsync();
        }
    }

    private Task DlMTemplate() => DownloadText(MTemplate, "m_employees_template.csv");
    private Task DlMExample() => DownloadText(MExample, "m_employees_example.csv");
    private Task DlTTemplate() => DownloadText(TTemplate, "t_employees_template.csv");
    private Task DlTExample() => DownloadText(TExample, "t_employees_example.csv");
    private Task DlSchedTemplate() => DownloadText(ScheduleTemplate, "schedule_template.csv");
    private Task DlSchedExample() => DownloadText(ScheduleExample, "schedule_example.csv");
    private Task DlEventsExample() => DownloadText(EventsExample, "events_example.csv");

    private async Task DownloadText(string content, string filename)
    {
        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(content)).ToArray();
        var b64 = Convert.ToBase64String(bytes);
        await Js.InvokeVoidAsync("eval",
            $@"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';a.download='{filename}';a.click();}})()");
    }

    private static async Task<byte[]> ReadAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(20_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }
}

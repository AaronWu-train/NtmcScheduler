@page "/runs/{Id:long}"
@rendermode InteractiveServer
@implements IDisposable
@inject IScheduleRunService RunsSvc
@inject IRuleSettingService RulesSvc

<PageTitle>Run #@Id</PageTitle>

<h1 class="h3 mb-3">Run #@Id</h1>

@if (_progress is null)
{
    <div class="text-muted">載入中…</div>
}
else
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="badge text-bg-secondary">@_progress.Status</span>
        @if (_progress.ScheduleStatus is not null)
        {
            <span class="badge text-bg-info">@_progress.ScheduleStatus</span>
        }
        @if (_progress.OptimizationStatus is { } opt)
        {
            <span class="badge @(opt == OptimizationStatus.Optimal ? "text-bg-success" : "text-bg-warning")">@opt</span>
        }
        <span>候選數：@_progress.CandidateCount</span>
        <a class="btn btn-sm btn-outline-primary" href="@($"runs/{Id}/candidates")">候選比較</a>
        @if (_progress.ShortageAnalysisAvailable ||
             _progress.ScheduleStatus == ScheduleStatus.Infeasible)
        {
            <a class="btn btn-sm btn-outline-danger" href="@($"runs/{Id}/shortage")">缺班分析／衝突摘要</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(_progress.ErrorMessage))
    {
        <div class="alert alert-danger">@_progress.ErrorMessage</div>
    }

    <h2 class="h6">規則進度</h2>
    <ul class="list-group mb-3" style="max-width: 36rem;">
        @foreach (var ruleId in _ruleIds)
        {
            var done = _progress.CompletedRuleIds.Contains(ruleId);
            var current = _progress.CurrentRuleId == ruleId;
            <li class="list-group-item d-flex justify-content-between">
                <code>@ruleId</code>
                <span>
                    @if (done) { <span class="text-success">✓ 已完成</span> }
                    else if (current) { <span class="text-primary">處理中…</span> }
                    else { <span class="text-muted">未處理</span> }
                </span>
            </li>
        }
    </ul>

    <div class="small text-muted">每 2 秒自動更新進度</div>
}

@code {
    [Parameter] public long Id { get; set; }

    private RunProgressDto? _progress;
    private IReadOnlyList<string> _ruleIds = Array.Empty<string>();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnParametersSetAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        await LoadAsync();

        // Infer unit from first progress load via rules of both — load M defaults for display stub
        var rules = await RulesSvc.GetAsync(Unit.M);
        _ruleIds = rules.Where(r => r.Enabled).OrderBy(r => r.Priority).ThenBy(r => r.Order).Select(r => r.RuleId).ToList();

        _ = PollLoop(_cts.Token);
    }

    private async Task LoadAsync() => _progress = await RunsSvc.GetProgressAsync(Id);

    private async Task PollLoop(CancellationToken ct)
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
                if (_progress?.Status is RunLifecycleStatus.Completed or RunLifecycleStatus.Failed)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}

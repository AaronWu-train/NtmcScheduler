@inject IJSRuntime Js
@inject OperatorState Operator

<div class="operator-box d-flex align-items-center gap-2">
    <label class="form-label mb-0 small text-nowrap" for="operator-input">目前操作者</label>
    <input id="operator-input"
           class="form-control form-control-sm"
           style="max-width: 10rem;"
           @bind="_value"
           @bind:event="oninput"
           @onblur="PersistAsync"
           @onkeydown="OnKeyDown"
           placeholder="輸入姓名" />
</div>

@code {
    private string _value = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("localStorage.getItem", "ntm.operator");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _value = stored;
                Operator.Set(stored);
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // prerender / disconnected
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await PersistAsync();
    }

    private async Task PersistAsync()
    {
        Operator.Set(_value);
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", "ntm.operator", Operator.Name);
        }
        catch (JSException)
        {
        }
    }
}

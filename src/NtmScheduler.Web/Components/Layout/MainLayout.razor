@inherits LayoutComponentBase
@inject OperatorState Operator

<div class="page d-flex">
    <aside class="sidebar border-end bg-light">
        <div class="sidebar-brand px-3 py-3 border-bottom">
            <div class="fw-semibold">NtmScheduler</div>
            <div class="small text-muted">新北捷人員排班</div>
        </div>
        <div class="py-3">
            <NavMenu />
        </div>
    </aside>

    <div class="main flex-grow-1 d-flex flex-column min-vh-100">
        <header class="topbar border-bottom px-3 py-2 d-flex justify-content-between align-items-center bg-white sticky-top">
            <div class="small text-muted">第一版 · 站務 M／檢測 T</div>
            <OperatorBox />
        </header>
        <main class="content px-3 py-3 flex-grow-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    發生未處理錯誤。
    <a href="." class="reload">重新載入</a>
    <span class="dismiss">🗙</span>
</div>

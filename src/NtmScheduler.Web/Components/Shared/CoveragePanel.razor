<div class="card h-100">
    <div class="card-header py-2">Coverage／休假統計</div>
    <div class="card-body" style="max-height: 20rem; overflow: auto;">
        @if (MCoverage is { Count: > 0 })
        {
            <h6 class="small fw-semibold">M 班位覆蓋</h6>
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>日期</th><th>站</th><th>班</th>
                        <th>需求</th><th>指派</th><th>外派</th><th>缺額</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in MCoverage.Take(100))
                    {
                        <tr class="@(r.Unassigned > 0 ? "table-danger" : null)">
                            <td>@r.Date.ToString("MM-dd")</td>
                            <td>@r.Location</td>
                            <td>@r.Shift.ToDisplay()</td>
                            <td>@r.Required</td>
                            <td>@r.Assigned</td>
                            <td>@r.External</td>
                            <td>@r.Unassigned</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (TCoverage is { Count: > 0 })
        {
            <h6 class="small fw-semibold">T 出勤覆蓋</h6>
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>日期</th><th>班</th><th>人數</th>
                        <th>出勤</th><th>目標</th><th>均能力</th><th>缺專業</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in TCoverage.Take(100))
                    {
                        <tr>
                            <td>@r.Date.ToString("MM-dd")</td>
                            <td>@r.Shift.ToDisplay()</td>
                            <td>@r.GroupSize</td>
                            <td>@r.NormalAttend</td>
                            <td>@r.AttendTarget</td>
                            <td>@r.AvgAbility.ToString("0.00")</td>
                            <td>@string.Join(",", r.MissingSpecialties)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-muted small">尚無 Coverage 資料（求解／驗證後顯示）</div>
        }

        @if (RestStatsRows is { Count: > 0 })
        {
            <h6 class="small fw-semibold mt-3">休假統計（含 R1）</h6>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>員工</th>
                        <th>月 R+R*</th><th>月 R1</th>
                        <th>週期 R</th><th>週期 R1</th>
                        <th>保留 R</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (id, name, s) in RestStatsRows)
                    {
                        <tr>
                            <td>@name <span class="text-muted">@id</span></td>
                            <td>@s.MonthGeneralRest</td>
                            <td>@s.MonthR1</td>
                            <td>@s.CycleGeneralRest/@s.RequiredR</td>
                            <td>@s.CycleR1/@s.RequiredR1</td>
                            <td>@s.ReservedGeneralRest</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<MCoverageRow>? MCoverage { get; set; }
    [Parameter] public IReadOnlyList<TCoverageRow>? TCoverage { get; set; }
    [Parameter] public IReadOnlyList<(string Id, string Name, RestStatsDto Stats)>? RestStatsRows { get; set; }
}

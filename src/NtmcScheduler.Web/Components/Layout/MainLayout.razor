@using System.Reflection
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<header class="app-header">
    <a class="brand" href="/">新北捷運人員排班系統 <span class="app-version">v@(AppVersion)</span></a>
    <AuthorizeView>
        <Authorized Context="auth">
            <NavMenu />
            <span class="user-name">@auth.User.Identity?.Name</span>
            <form action="/Account/ChangePassword" method="get">
                <button type="submit" class="link-button">修改密碼</button>
            </form>
            <form action="/Account/Logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="link-button">登出</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>
<main class="page-shell">
    @Body
</main>

@code {
    private static readonly string AppVersion = GetAppVersion();

    private static string GetAppVersion()
    {
        var version =
            typeof(App).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "1.3.1";
        var metadataIndex = version.IndexOf('+');
        return metadataIndex >= 0 && version.Length > metadataIndex + 8
            ? version[..(metadataIndex + 8)]
            : version;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += AuthenticationStateChanged;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true && user.FindFirst("must_change_password")?.Value == "true" &&
            !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("Account/ChangePassword", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("/Account/ChangePassword", forceLoad: true);
    }

    private void AuthenticationStateChanged(Task<AuthenticationState> authenticationState) =>
        _ = RedirectIfSignedOutAsync(authenticationState);

    private async Task RedirectIfSignedOutAsync(Task<AuthenticationState> authenticationState)
    {
        if ((await authenticationState).User.Identity?.IsAuthenticated != true)
            await InvokeAsync(() => Navigation.NavigateTo("/", forceLoad: true));
    }

    public void Dispose() => AuthenticationStateProvider.AuthenticationStateChanged -= AuthenticationStateChanged;
}

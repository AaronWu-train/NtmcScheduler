@page "/schedules/{VersionId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScheduleService Service
@inject ICommonConfigurationService ConfigurationService
@inject CurrentActorService CurrentActor
@inject IJSRuntime JS

<PageTitle>班表編輯器</PageTitle>
@if (detail is null)
{
    <p class="empty-state">正在載入班表…</p>
}
else
{
    <WorkspaceNav Workspace="@detail.Version.Workspace.ToString().ToLowerInvariant()"/>
    <div class="page-title">
        <div>
            <div class="title-line">
                @if (isEditingName)
                {
                    <input class="inline-field" aria-label="班表名稱" value="@detail.Version.Name" disabled="@isBusy" @onchange="args => RenameAsync(args.Value?.ToString() ?? string.Empty)" />
                    <button class="icon-button" aria-label="取消修改班表名稱" title="取消" disabled="@isBusy" @onclick="() => isEditingName = false">×</button>
                }
                else
                {
                    <h1>@detail.Version.Name</h1>
                    @if (canEdit && !detail.Version.IsArchived)
                    {
                        <button class="icon-button" aria-label="修改班表名稱" title="修改班表名稱" disabled="@isBusy" @onclick="() => isEditingName = true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button>
                    }
                }
                @if (detail.Version.IsAdopted)
                {
                    <span class="adopted-badge">已採用</span>
                }
                @if (detail.Version.IsArchived)
                {
                    <span class="status">已封存</span>
                }
            </div>
            <p>@detail.Version.Workspace／@detail.Version.Month.ToString("yyyy 年 MM 月")｜直接點選日格即可修改</p>
        </div>
        <PageHelp Title="班表編輯器說明">
            <p>紅框只代表違反勞基法。右側可檢查 56 日區間與本月統計；M 班表底部可檢查各站每日人數及外派。</p>
        </PageHelp>
    </div>
    @if (message is not null)
    {
        <p class="alert @messageClass" role="status">@message</p>
    }

    <div class="editor-toolbar">
        <a class="button-link" href="/@detail.Version.Workspace.ToString().ToLowerInvariant()/schedules">返回班表列表</a>
        <div class="toolbar-actions">
            <a class="button-link" href="/download/schedules/@(VersionId).csv">下載班表 CSV</a>
            @if (detail.ExternalAssignments.Count > 0)
            {
                <a class="button-link" href="/download/schedules/@(VersionId)-external.csv">下載外派 CSV</a>
            }
            @if (canEdit && detail.Version.IsAdopted)
            {
                <button disabled="@isBusy" @onclick="UnadoptAsync">取消採用</button>
            }
            else if (canEdit && !detail.Version.IsArchived)
            {
                <button class="primary" disabled="@isBusy" @onclick="AdoptAsync">@(isBusy ? "處理中…" : "採用這份班表")</button>
                <button class="danger" disabled="@isBusy" @onclick="ArchiveAsync">封存班表</button>
            }
        </div>
    </div>

    <div class="schedule-legend" aria-label="班表文字圖例">
        <span class="rest-text">R 休假</span><span>早班</span><span class="afternoon-text">@(detail.Version.Workspace == WorkspaceCode.M ? "小班" : "午班")</span><strong>夜班</strong><span class="event-text">X 非常態班型</span><span class="labor-mark">! 勞基法違規</span>
    </div>
    <div class="table-scroll schedule-grid compact-schedule">
        <table>
            <thead>
            <tr>
                <th class="sticky-col sticky-id sortable" rowspan="2">
                    <button class="sort-button" @onclick='() => SortBy("id")'>ID @SortMark("id")</button>
                </th>
                <th class="sticky-col sticky-name sortable" rowspan="2">
                    <button class="sort-button" @onclick='() => SortBy("name")'>姓名 @SortMark("name")</button>
                </th>
                <th class="sticky-col sticky-affiliation sortable" rowspan="2">
                    <button class="sort-button" @onclick='() => SortBy("affiliation")'>所屬 @SortMark("affiliation")</button>
                </th>
                @if (detail.Version.Workspace == WorkspaceCode.T)
                {
                    <th class="sticky-col sticky-monthly-shift sortable" rowspan="2">
                        <button class="sort-button" @onclick='() => SortBy("monthlyShift")'>T月班別 @SortMark("monthlyShift")</button>
                    </th>
                }
                @foreach (var day in Days())
                {
                    <th rowspan="2" class="day-header @DateClass(day)">
                        <span>@day.Day</span><small>@Weekday(day)</small>
                        @if (IsIntervalStart(day))
                        {
                            <em class="interval-start-label">16R起</em>
                        }
                    </th>
                }
                @foreach (var interval in Intervals())
                {
                    <th colspan="2" class="summary-group">@interval.Start.ToString("M/d")–@interval.End.ToString("M/d")</th>
                }
                <th colspan="8" class="summary-group">本月統計</th>
            </tr>
            <tr>
                @foreach (var interval in Intervals())
                {
                    <th>R</th>
                    <th>R1</th>
                }
                <th>R</th><th>R1</th><th>R休</th><th>早</th><th>@(detail.Version.Workspace == WorkspaceCode.M ? "小" : "午")</th><th>夜</th><th>X</th><th>班數</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var employee in SortedEmployees())
            {
                var stats = detail.EmployeeStats.Single(x => x.EmployeeCode == employee.EmployeeCode);
                <tr>
                    <td class="sticky-col sticky-id">@employee.EmployeeCode</td>
                    <td class="sticky-col sticky-name">
                        @employee.Name
                        @if (IsNewHire(employee))
                        {
                            <small class="new-hire">新人 @employee.EmploymentStartDate!.Value.ToString("M/d")</small>
                        }
                    </td><td class="sticky-col sticky-affiliation">@employee.Affiliation</td>
                    @if (detail.Version.Workspace == WorkspaceCode.T)
                    {
                        <td class="sticky-col sticky-monthly-shift">
                            <select class="cell-editor" aria-label="@employee.Name 的 T 月班別" disabled="@(!canEdit || detail.Version.IsArchived || isBusy)" value="@employee.MonthlyShift" @onchange='args => UpdateMonthlyShiftAsync(employee, args.Value?.ToString())'>
                                <option value="Early">早</option><option value="Afternoon">午</option><option value="Night">夜</option>
                            </select>
                        </td>
                    }
                    @foreach (var day in Days())
                    {
                        var cell = detail.Assignments.FirstOrDefault(x => x.EmployeeSnapshotId == employee.Id && x.Date == day);
                        var issues = Issues(employee.EmployeeCode, day);
                        <td class="day-cell @DateClass(day) @IssueClass(issues) @SuggestionClass(employee.EmployeeCode, day)" id="cell-@employee.EmployeeCode-@day.ToString("yyyyMMdd")">
                            @if (cell is not null)
                            {
                                <button class="schedule-cell @CellClass(cell)" disabled="@(!canEdit || detail.Version.IsArchived || isBusy)" title="@IssueText(issues)" aria-label="@employee.Name @day.ToString("MM-dd") @CellText(cell)" @onclick="() => OpenCell(cell)">
                                    @if (issues.Any(x => x.IsLaborLawViolation))
                                    {
                                        <span class="labor-icon" aria-hidden="true">!</span>
                                    }
                                    @CellText(cell)
                                </button>
                            }
                            else if (employee.EmploymentStartDate is { } start && day < start)
                            {
                                <span class="not-applicable">—</span>
                            }
                        </td>
                    }
                    @foreach (var interval in Intervals())
                    {
                        var value = IntervalStat(employee.EmployeeCode, interval);
                        var restTarget = IntervalRestTarget(interval);
                        var specialRestTarget = IntervalSpecialRestTarget(interval);
                        <td class="@TargetHeatClass(value.Rest, restTarget)" title="實際 @value.Rest／本月目標 @restTarget（完整區間目標 16）">@value.Rest/16</td>
                        <td class="@TargetHeatClass(value.SpecialRest, specialRestTarget)" title="實際 @value.SpecialRest／本月目標 @specialRestTarget（完整區間目標 @value.RequiredSpecialRest）">@value.SpecialRest/@value.RequiredSpecialRest</td>
                    }
                    <td>@stats.Rest</td><td>@stats.SpecialRest</td><td>@stats.LeaveRest</td><td class="@ShiftHeatClass(stats.Early, x => x.Early)" title="早班：同欄最大值為綠、最小值為紅">@stats.Early</td><td class="@ShiftHeatClass(stats.Afternoon, x => x.Afternoon)" title="@(detail.Version.Workspace == WorkspaceCode.M ? "小班" : "午班")：同欄最大值為綠、最小值為紅">@stats.Afternoon</td><td class="@ShiftHeatClass(stats.Night, x => x.Night)" title="夜班：同欄最大值為綠、最小值為紅">@stats.Night</td><td>@stats.Other</td><td>@(stats.Early + stats.Afternoon + stats.Night + stats.Other)</td>
                </tr>
            }
    @if (detail.Version.Workspace == WorkspaceCode.M)
    {
        @foreach (var station in MStations)
        {
                    <tr class="coverage-row">
                        <th class="sticky-col sticky-id">@station</th><td class="sticky-col sticky-name">車站統計</td><td class="sticky-col sticky-affiliation"></td>
                        @foreach (var day in Days())
                        {
                            var early = Coverage(day, station, "Early");
                            var afternoon = Coverage(day, station, "Afternoon");
                            var night = Coverage(day, station, "Night");
                            <td class="coverage-cell @DateClass(day) @(HasCoverageProblem(early, afternoon, night) ? "coverage-problem" : "")" title="實際/需求；外派PA另列">
                                <span>早 @(early.Internal + early.External)/@early.Required–@early.Maximum</span>
                                <span>小 @(afternoon.Internal + afternoon.External)/@afternoon.Required–@afternoon.Maximum</span>
                                <span>夜 @(night.Internal + night.External)/@night.Required–@night.Maximum</span>
                                @if (early.External + afternoon.External + night.External > 0)
                                {
                                    <strong>PA @(early.External + afternoon.External + night.External)</strong>
                                }
                            </td>
                        }
                        <td colspan="@(Intervals().Count * 2 + 8)"></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (detail.Issues.Count > 0 || Suggestions().Count > 0)
    {
        <details class="issue-details">
            <summary>檢查結果（@(detail.Issues.Count + Suggestions().Count)）</summary>
            <ul class="issue-list">
                @foreach (var issue in detail.Issues)
                {
                    <li class="@(issue.IsLaborLawViolation ? "issue-error" : issue.Severity == ValidationSeverity.Error ? "issue-blocking" : "issue-warning")">
                        <strong>@issue.RuleName</strong>：@issue.Message
                        @if (issue.EmployeeCode is not null && issue.Date is not null)
                        {
                            <button class="location-link" @onclick="() => ScrollToCellAsync(issue.EmployeeCode, issue.Date.Value)">@issue.EmployeeCode／@issue.Date.Value.ToString("M/d")</button>
                        }
                    </li>
                }
                @foreach (var suggestion in Suggestions())
                {
                    <li class="issue-warning"><strong>建議</strong>：@SuggestionText(suggestion.Name)（違反量 @suggestion.Value）
                        @if (suggestion.Locations.Count > 0)
                        {
                            <details class="suggestion-locations">
                                <summary>位置（@suggestion.Locations.Count 項）</summary>
                                @foreach (var location in suggestion.Locations)
                                {
                                    @if (location.EmployeeCode is not null && location.Date is not null)
                                    {
                                        <button class="location-link" @onclick="() => ScrollToCellAsync(location.EmployeeCode, location.Date.Value)">@location.Label</button><span>、</span>
                                    }
                                    else
                                    {
                                        <span>@location.Label、</span>
                                    }
                                }
                            </details>
                        }
                    </li>
                }
            </ul>
        </details>
    }
}

@if (editingCell is not null)
{
    <div class="modal-backdrop"></div>
    <section class="editor-dialog" role="dialog" aria-modal="true">
        <h2>@editingCell.EmployeeName／@editingCell.Date.ToString("yyyy-MM-dd")</h2>
        <label>
            班別或休假
            <select @bind="cellEdit.Value">
                <option value="Rest">R</option><option value="SpecialRest">R1</option><option value="LeaveRest">R休</option><option value="RequestedRest">R*</option><option value="RequestedSpecialRest">R1*</option><option value="RequestedLeaveRest">R休*</option><option value="WorkEarly">早班</option><option value="WorkAfternoon">@(detail!.Version.Workspace == WorkspaceCode.M ? "小班" : "午班")</option><option value="WorkNight">夜班</option><option value="WorkEvent">X／非常態班型</option>
            </select>
        </label>
        @if (cellEdit.Value.StartsWith("Work", StringComparison.Ordinal) && cellEdit.Value != "WorkEvent" && detail!.Version.Workspace == WorkspaceCode.M)
        {
            <label>
                車站
                <select @bind="cellEdit.Station">
                    @foreach (var station in MStations)
                    {
                        <option value="@station">@station</option>
                    }
                </select>
            </label>
        }
        @if (cellEdit.Value == "WorkEvent")
        {
            <label>
                非常態班型
                <select @onchange="ApplyNonStandard">
                    <option value="">自行輸入</option>
                    @foreach (var shift in configuration?.NonStandardShifts ?? [])
                    {
                        <option value="@shift.Code">@(shift.Name ?? shift.Code)</option>
                    }
                </select>
            </label>
            <label>開始<input type="datetime-local" @bind="cellEdit.Start"/></label>
            <label>結束<input type="datetime-local" @bind="cellEdit.End"/></label>
            <label>名稱或說明<input maxlength="500" @bind="cellEdit.Description"/></label>
        }
        <div class="step-actions">
            <button disabled="@isBusy" @onclick="CloseEditor">取消</button><button class="primary" disabled="@isBusy" @onclick="SaveCellAsync">@(isBusy ? "處理中…" : "儲存日格")</button>
        </div>
    </section>
}

@code {
    [Parameter] public Guid VersionId { get; set; }
    private IEnumerable<string> MStations => detail?.Coverage.Select(x => x.Station).Distinct(StringComparer.Ordinal) ?? [];
    private ScheduleDetailDto? detail;
    private ConfigurationRevisionDto? configuration;
    private bool canEdit;
    private bool isBusy;
    private bool isEditingName;
    private string? message;
    private string messageClass = "success";
    private string sortColumn = "id";
    private bool sortDescending;
    private ScheduleAssignmentDto? editingCell;
    private readonly CellEdit cellEdit = new();
    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        sortColumn = detail!.Version.Workspace == WorkspaceCode.M ? "affiliation" : "id";
        sortDescending = false;
    }

    private async Task LoadAsync()
    {
        var actor = await CurrentActor.GetAsync();
        detail = await Service.GetAsync(VersionId, actor);
        configuration = await ConfigurationService.GetRevisionAsync(detail.Version.ConfigurationRevisionId, actor);
        canEdit = actor.CanEdit(detail.Version.Workspace) && !actor.MustChangePassword;
    }

    private IReadOnlyList<DateOnly> Days() => Enumerable.Range(0, DateTime.DaysInMonth(detail!.Version.Month.Year, detail.Version.Month.Month)).Select(detail.Version.Month.AddDays).ToArray();
    private IReadOnlyList<RestIntervalDto> Intervals() => configuration?.RestIntervals.Where(x => x.Start <= detail!.Version.Month.AddMonths(1).AddDays(-1) && x.End >= detail.Version.Month).OrderBy(x => x.Start).ToArray() ?? [];

    private IEnumerable<ScheduleEmployeeInfoDto> SortedEmployees()
    {
        if (sortColumn == "monthlyShift")
        {
            var monthlyShiftOrdered = sortDescending
                ? detail!.Employees.OrderByDescending(x => MonthlyShiftSortOrder(x.MonthlyShift))
                : detail!.Employees.OrderBy(x => MonthlyShiftSortOrder(x.MonthlyShift));
            return monthlyShiftOrdered.ThenBy(x => x.EmployeeCode, StringComparer.OrdinalIgnoreCase);
        }

        Func<ScheduleEmployeeInfoDto, string> key = sortColumn switch { "name" => x => x.Name, "affiliation" => x => x.Affiliation, _ => x => x.EmployeeCode };
        var ordered = sortDescending ? detail!.Employees.OrderByDescending(key, StringComparer.OrdinalIgnoreCase) : detail!.Employees.OrderBy(key, StringComparer.OrdinalIgnoreCase);
        return ordered.ThenBy(x => x.EmployeeCode, StringComparer.OrdinalIgnoreCase);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column) sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
    }

    private string SortMark(string column) => sortColumn == column ? sortDescending ? "▼" : "▲" : "";
    private static int MonthlyShiftSortOrder(string? monthlyShift) => monthlyShift switch { "Early" => 0, "Afternoon" => 1, "Night" => 2, _ => 3 };
    private bool IsNewHire(ScheduleEmployeeInfoDto employee) => employee.EmploymentStartDate is { } date && date >= detail!.Version.Month && date < detail.Version.Month.AddMonths(1);

    private string DateClass(DateOnly date)
    {
        var holiday = configuration?.RestIntervals.SelectMany(x => x.NationalHolidays).Contains(date) == true;
        var boundary = configuration?.RestIntervals.Any(x => x.Start == date) == true;
        return (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday || holiday ? "holiday-column " : "") + (boundary ? "interval-boundary" : "");
    }

    private bool IsIntervalStart(DateOnly date) => configuration?.RestIntervals.Any(x => x.Start == date) == true;
    private static string Weekday(DateOnly date) => "日一二三四五六"[(int)date.DayOfWeek].ToString();
    private IReadOnlyList<ValidationIssue> Issues(string employee, DateOnly day) => detail!.Issues.Where(x => x.EmployeeCode == employee && x.Date == day).ToArray();
    private static string IssueText(IReadOnlyList<ValidationIssue> issues) => string.Join("；", issues.Select(x => x.Message));
    private static string IssueClass(IReadOnlyList<ValidationIssue> issues) => issues.Any(x => x.IsLaborLawViolation) ? "labor-violation" : issues.Any(x => x.Severity == ValidationSeverity.Error) ? "blocking-issue" : issues.Count > 0 ? "advisory-issue" : "";
    private string SuggestionClass(string employeeCode, DateOnly date) => Suggestions().Any(suggestion => suggestion.Locations.Any(location => location.EmployeeCode == employeeCode && location.Date == date)) ? "suggested-cell" : "";
    private async Task ScrollToCellAsync(string employeeCode, DateOnly date) =>
        await JS.InvokeVoidAsync("scrollToScheduleCell", $"cell-{employeeCode}-{date:yyyyMMdd}");
    private IReadOnlyList<ScheduleSuggestionDto> Suggestions() => detail?.Suggestions ?? (detail?.Version.Objectives ?? [])
        .SelectMany(objective => objective.Components)
        .Where(component => component.Value > 0 && DisplaysSuggestion(component.Name))
        .Select(component => new ScheduleSuggestionDto(component.Name, component.Value, []))
        .ToArray();

    private bool DisplaysSuggestion(string name) => detail!.Version.Workspace switch
    {
        WorkspaceCode.T => name is not "MonthBoundaryRestBalance" and not "UnusedLeaveRest" and not "MonthlyRest"
            and not "SpecialRestBalance" and not "WeekdayRestFairness" and not "HolidayRestFairness",
        WorkspaceCode.M => name is not "ExternalStaffing" and not "MixedShiftWorkStreak" and not "NightRestEarly"
            and not "NightRestAfternoon" and not "ShiftChangeWithoutRest" and not "HolidayRestFairness"
            and not "EarlyAfternoonImbalance" and not "NightShiftTarget",
        _ => false
    };

    private static string SuggestionText(string name) => name switch
    {
        "RequestedRest" => "調整人力或指定休假，盡量滿足 R*",
        "UnusedLeaveRest" => "檢視可使用的指定 R休 額度",
        "ExternalStaffing" => "調整同三站群組的人力，減少超過門檻的外援",
        "MonthlyRest" => "調整一般 R，使每人更接近當月目標",
        "SpecialRestBalance" => "調整 R1，使八週累積額度更接近國定假日目標",
        "WorkStreak" => "調整休假位置，避免過短或過長的連續工作區段",
        "MixedShiftWorkStreak" => "讓同一連續工作區段盡量維持單一正常班型",
        "NightRestEarly" => "避免夜班後休一天即接早班",
        "NightRestAfternoon" => "避免夜班後休一天即接小／午班",
        "ShiftChangeWithoutRest" => "在不同正常班型之間安排實際休假",
        "NonHomeStation" => "減少個人超過 8 班的非所屬站工作",
        "HolidayRestFairness" => "在比較群組內平衡假日休假次數",
        "EarlyAfternoonImbalance" => "平衡個人的早班與小／午班數",
        "NightShiftTarget" => "讓每人的夜班數盡量落在 3 至 4 天",
        "NonMonthlyShift" => "讓實際班別更接近人員的 T 月班別",
        "Attendance" => "補足各班組每日出勤人數",
        "Specialty" => "補足各班應有的專業分組",
        "Ability" => "補足每班能力 4 至 5 的出勤人員",
        "NightToEarlyRest" => "增加夜班轉早班前的休假",
        "MonthBoundaryRestBalance" => "調整月初與月底交界的休假安排",
        "WeekdayRestFairness" => "在班組內平衡平日休假次數",
        _ => name
    };
    private static string CellClass(ScheduleAssignmentDto cell) => cell.Kind switch { "Rest" or "SpecialRest" or "LeaveRest" => "rest-text", "Work" when cell.Shift == "Afternoon" => "afternoon-text", "Work" when cell.Shift == "Night" => "night-text", "WorkEvent" => "event-text", _ => "" };
    private string CellText(ScheduleAssignmentDto cell) => cell switch { { Kind: "Rest", RequestedRest: true } => "R*", { Kind: "SpecialRest", RequestedRest: true } => "R1*", { Kind: "LeaveRest", RequestedRest: true } => "R休*", { Kind: "Rest" } => "R", { Kind: "SpecialRest" } => "R1", { Kind: "LeaveRest" } => "R休", { Kind: "WorkEvent" } => string.IsNullOrWhiteSpace(cell.EventDescription) ? "X" : cell.EventDescription!, { Kind: "Work", Shift: "Early" } => WorkText(cell, "早"), { Kind: "Work", Shift: "Afternoon" } => WorkText(cell, detail!.Version.Workspace == WorkspaceCode.M ? "小" : "午"), { Kind: "Work", Shift: "Night" } => WorkText(cell, "夜"), _ => "?" };
    private string WorkText(ScheduleAssignmentDto cell, string shift)
    {
        if (detail!.Version.Workspace != WorkspaceCode.M || cell.Station is null) return shift;
        return cell.Station.Length == 4 && cell.Station.StartsWith("LB", StringComparison.Ordinal) && int.TryParse(cell.Station[2..], out var number)
            ? $"{number}{shift}" : $"{cell.Station}{shift}";
    }
    private ScheduleIntervalStatsDto IntervalStat(string employee, RestIntervalDto interval) => detail!.IntervalStats.Single(x => x.EmployeeCode == employee && x.Start == interval.Start);
    private ScheduleCoverageDto Coverage(DateOnly day, string station, string shift) => detail!.Coverage.Single(x => x.Date == day && x.Station == station && x.Shift == shift);
    private int IntervalRestTarget(RestIntervalDto interval)
    {
        var monthStart = detail!.Version.Month;
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        if (interval.End <= monthEnd) return 16;
        return AllocatedMonthlyTarget(interval, detail.Version.GeneralRestTarget ?? 0, false);
    }

    private int IntervalSpecialRestTarget(RestIntervalDto interval)
    {
        var monthStart = detail!.Version.Month;
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        if (interval.End <= monthEnd) return interval.NationalHolidays.Count;
        return AllocatedMonthlyTarget(interval, detail.Version.SpecialRestTarget ?? 0, true);
    }

    private int AllocatedMonthlyTarget(RestIntervalDto interval, int target, bool special)
    {
        var monthStart = detail!.Version.Month;
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        var intervals = configuration!.RestIntervals.Where(x => x.Start <= monthEnd && x.End >= monthStart).OrderBy(x => x.Start).ToArray();
        var weights = intervals.Select(x => special
            ? x.NationalHolidays.Count(date => date >= monthStart && date <= monthEnd)
            : Enumerable.Range(Math.Max(x.Start.DayNumber, monthStart.DayNumber), Math.Min(x.End.DayNumber, monthEnd.DayNumber) - Math.Max(x.Start.DayNumber, monthStart.DayNumber) + 1)
                .Count(day => DateOnly.FromDayNumber(day).DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)).ToArray();
        if (weights.Sum() == 0) weights = intervals.Select(x => Math.Min(x.End.DayNumber, monthEnd.DayNumber) - Math.Max(x.Start.DayNumber, monthStart.DayNumber) + 1).ToArray();
        var total = Math.Max(1, weights.Sum());
        var allocations = weights.Select(weight => target * weight / total).ToArray();
        var remainder = target - allocations.Sum();
        var index = 0;
        for (; remainder > 0; remainder--, index = (index + 1) % allocations.Length) allocations[index]++;
        return allocations[Array.IndexOf(intervals, interval)];
    }

    private static string TargetHeatClass(int actual, int target)
    {
        if (actual == target) return "interval-stat";
        var level = Math.Min(4, Math.Max(1, (int)Math.Ceiling(4d * Math.Abs(actual - target) / Math.Max(1, target))));
        return $"interval-stat interval-{(actual > target ? "over" : "under")}-{level}";
    }

    private string ShiftHeatClass(int value, Func<ScheduleEmployeeStats, int> selector)
    {
        var values = detail!.EmployeeStats.Select(selector).ToArray();
        var min = values.Min();
        var max = values.Max();
        var position = max == min ? .5 : (value - min) / (double)(max - min);
        return $"shift-stat shift-{Math.Clamp((int)Math.Round(position * 4), 0, 4)}";
    }

    private static bool HasCoverageProblem(params ScheduleCoverageDto[] values) => values.Any(x =>
        x.Internal + x.External < x.Required || x.Internal + x.External > x.Maximum);

    private void OpenCell(ScheduleAssignmentDto cell)
    {
        editingCell = cell;
        cellEdit.Value = cell switch { { Kind: "Rest", RequestedRest: true } => "RequestedRest", { Kind: "SpecialRest", RequestedRest: true } => "RequestedSpecialRest", { Kind: "LeaveRest", RequestedRest: true } => "RequestedLeaveRest", { Kind: "Work", Shift: "Early" } => "WorkEarly", { Kind: "Work", Shift: "Afternoon" } => "WorkAfternoon", { Kind: "Work", Shift: "Night" } => "WorkNight", _ => cell.Kind };
        cellEdit.Station = cell.Station ?? detail!.Employees.Single(x => x.Id == cell.EmployeeSnapshotId).Affiliation;
        cellEdit.Start = LocalText(cell.EventStart);
        cellEdit.End = LocalText(cell.EventEnd);
        cellEdit.Description = cell.EventDescription ?? "";
    }

    private async Task SaveCellAsync() => await RunAsync(async () =>
    {
        var (kind, requested, shift) = cellEdit.Value switch { "RequestedRest" => ("Rest", true, (string?)null), "RequestedSpecialRest" => ("SpecialRest", true, null), "RequestedLeaveRest" => ("LeaveRest", true, null), "LeaveRest" => ("LeaveRest", false, null), "WorkEarly" => ("Work", false, "Early"), "WorkAfternoon" => ("Work", false, "Afternoon"), "WorkNight" => ("Work", false, "Night"), "WorkEvent" => ("WorkEvent", false, null), _ => (cellEdit.Value, false, null) };
        detail = await Service.UpdateAssignmentAsync(VersionId, editingCell!.Id, kind, requested, detail!.Version.Workspace == WorkspaceCode.M ? cellEdit.Station : null, shift, Offset(cellEdit.Start), Offset(cellEdit.End), cellEdit.Description, detail.Version.RevisionToken, await CurrentActor.GetAsync());
        CloseEditor();
    }, "日格已儲存並重新檢查整月班表。");

    private Task AdoptAsync() => RunAsync(async () =>
    {
        await Service.AdoptAsync(VersionId, detail!.Version.RevisionToken, await CurrentActor.GetAsync());
        await LoadAsync();
    }, "已採用這份班表。");

    private Task UnadoptAsync() => RunAsync(async () =>
    {
        await Service.UnadoptAsync(VersionId, detail!.Version.RevisionToken, await CurrentActor.GetAsync());
        await LoadAsync();
    }, "已取消採用這份班表。");

    private Task RenameAsync(string name) => RunAsync(async () =>
    {
        await Service.RenameAsync(VersionId, name, detail!.Version.RevisionToken, await CurrentActor.GetAsync());
        isEditingName = false;
        await LoadAsync();
    }, "班表名稱已更新。");

    private Task ArchiveAsync() => RunAsync(async () =>
    {
        await Service.ArchiveAsync(VersionId, detail!.Version.RevisionToken, await CurrentActor.GetAsync());
        await LoadAsync();
    }, "班表已封存。");

    private Task UpdateMonthlyShiftAsync(ScheduleEmployeeInfoDto employee, string? monthlyShift) => RunAsync(async () => { detail = await Service.UpdateMonthlyShiftAsync(VersionId, employee.Id, monthlyShift ?? "", detail!.Version.RevisionToken, await CurrentActor.GetAsync()); }, "T 月班別已儲存並重新檢查整月班表。");

    private void ApplyNonStandard(ChangeEventArgs args)
    {
        var shift = configuration?.NonStandardShifts.FirstOrDefault(x => x.Code == args.Value?.ToString());
        if (shift is null || editingCell is null) return;
        var endDate = shift.EndTime <= shift.StartTime ? editingCell.Date.AddDays(1) : editingCell.Date;
        cellEdit.Start = editingCell.Date.ToDateTime(shift.StartTime);
        cellEdit.End = endDate.ToDateTime(shift.EndTime);
        cellEdit.Description = shift.Name ?? shift.Code;
    }

    private static DateTimeOffset? Offset(DateTime? value) => value is null ? null : new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified), TimeSpan.FromHours(8));
    private static DateTime? LocalText(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(8)).DateTime;
    private void CloseEditor() => editingCell = null;

    private async Task RunAsync(Func<Task> action, string success)
    {
        isBusy = true;
        messageClass = "success";
        message = "處理中…";
        await InvokeAsync(StateHasChanged);
        try
        {
            await action();
            message = success;
        }
        catch (Exception exception)
        {
            messageClass = "error";
            message = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class CellEdit
    {
        public string Value { get; set; } = "Rest";
        public string Station { get; set; } = "LB01";
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
        public string Description { get; set; } = "";
    }


    private async Task DeleteDemandAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"確定要刪除 {MonthLabel(demand!.Month)} 的需求嗎？\n\n需求將無法復原；既有求解紀錄與班表都會保留。");
        if (!confirmed) return;
        await RunUiAsync(async () =>
        {
            var actor = await CurrentActor.GetAsync();
            await DemandService.DeleteAsync(demand.Id, demand.RevisionToken, actor);
            availableMonths = await DemandService.ListMonthsAsync(workspaceCode, actor);
            demand = null;
            configuration = null;
            previousVersion = null;
            previousOptions = [];
            runs = [];
            ClearLocalDemandEdits();
            pendingUploadPreviousSource = false;
            activeStep = 1;
            if (availableMonths.Count == 0) selectedMonth = "new";
            else
            {
                selectedMonth = monthText = MonthValue(availableMonths[0]);
                await LoadAsync();
            }
        }, "本月需求已刪除；既有求解紀錄與班表均已保留。");
    }


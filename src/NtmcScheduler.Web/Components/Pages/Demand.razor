    private async Task ChangeEmployeeFieldAsync(DemandEmployeeDto employee, EmployeeEdit edit, string field, string? value)
    {
        try
        {
            switch (field)
            {
                case "employmentStart": edit.EmploymentStartDate = ParseDate(value); break;
                case "monthlyShift": edit.MonthlyShift = value ?? "Early"; break;
                case "openingRest": edit.OpeningRest = ParseNullableNonNegative(value, "月初 R"); break;
                case "openingSpecialRest": edit.OpeningSpecialRest = ParseNullableNonNegative(value, "月初 R1"); break;
                case "leaveRest": edit.LeaveRest = ParseNullableNonNegative(value, "當月指定 R休") ?? 0; break;
                case "perpetual": edit.PerpetualId = value ?? ""; break;
            }
        }
        catch (Exception exception)
        {
            messageClass = "error";
            message = exception.Message;
            return;
        }

        if ((edit.OpeningRest is null) != (edit.OpeningSpecialRest is null)) return;
        await RunUiAsync(async () =>
        {
            demand = await DemandService.UpdateEmployeeAsync(demand!.Id, employee.EmployeeCode, edit.EmploymentStartDate, workspaceCode == WorkspaceCode.T ? edit.MonthlyShift : null,
                edit.OpeningRest, edit.OpeningSpecialRest, edit.LeaveRest, edit.PerpetualId, demand.RevisionToken, await CurrentActor.GetAsync());
            InitializeEmployeeEdits();
        }, "月份欄位已自動儲存。");
    }

    private static int? ParseNullableNonNegative(string? value, string label)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (!int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var number) || number < 0)
            throw new DomainValidationException($"{label} 必須是非負整數。");
        return number;
    }

    private static DateOnly? ParseDate(string? value) => string.IsNullOrWhiteSpace(value) ? null : DateOnly.ParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture);
    private static string DateText(DateOnly? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";

    private async Task ChangeCellAsync(DemandEmployeeDto employee, DateOnly date, DemandAssignmentDto? cell, string? value)
    {
        if (value == "Existing") return;
        if (value == "Other")
        {
            OpenOtherCell(employee, date, cell);
            return;
        }

        await RunUiAsync(async () =>
        {
            var isMWork = value?.StartsWith("m:", StringComparison.Ordinal) == true;
            var kind = value is "Early" or "Afternoon" or "Night" || isMWork ? "Work" : value?.StartsWith("ns:", StringComparison.Ordinal) == true ? "WorkEvent" : null;
            var requested = value == "RStar";
            var parts = isMWork ? value!.Split(':') : null;
            var shift = kind == "Work" ? parts?[2] ?? value : null;
            DateTimeOffset? start = null;
            DateTimeOffset? end = null;
            string? description = null;
            if (value?.StartsWith("ns:", StringComparison.Ordinal) == true)
            {
                var nonStandard = configuration!.NonStandardShifts.Single(x => x.Code == value[3..]);
                start = Offset(date.ToDateTime(nonStandard.StartTime));
                end = Offset((nonStandard.EndTime <= nonStandard.StartTime ? date.AddDays(1) : date).ToDateTime(nonStandard.EndTime));
                description = nonStandard.Name ?? nonStandard.Code;
            }

            demand = await DemandService.UpdateAssignmentAsync(demand!.Id, employee.EmployeeCode, date, kind, requested,
                kind == "Work" && workspaceCode == WorkspaceCode.M ? parts?[1] : null, shift,
                start, end, description, demand.RevisionToken, await CurrentActor.GetAsync());
        }, "日格已自動儲存。");
    }

    private void OpenOtherCell(DemandEmployeeDto employee, DateOnly date, DemandAssignmentDto? cell)
    {
        editingCellEmployee = employee;
        editingDate = date;
        cellEdit.Start = LocalText(cell?.EventStart) ?? date.ToDateTime(new TimeOnly(8, 30));
        cellEdit.End = LocalText(cell?.EventEnd) ?? date.ToDateTime(new TimeOnly(17, 30));
        cellEdit.Description = cell?.EventDescription ?? "";
    }

    private async Task SaveOtherCellAsync() => await RunUiAsync(async () =>
    {
        demand = await DemandService.UpdateAssignmentAsync(demand!.Id, editingCellEmployee!.EmployeeCode, editingDate, "WorkEvent", false, null, null,
            Offset(cellEdit.Start), Offset(cellEdit.End), cellEdit.Description, demand.RevisionToken, await CurrentActor.GetAsync());
        CloseEditors();
    }, "日格已自動儲存。");

    private static DateTimeOffset? Offset(DateTime? value) => value is null ? null : new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified), TimeSpan.FromHours(8));
    private static DateTime? LocalText(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(8)).DateTime;
    private void CloseEditors() => editingCellEmployee = null;

    private async Task RunUiAsync(Func<Task> action, string success)
    {
        await uiOperationLock.WaitAsync();
        try
        {
            isBusy = true;
            messageClass = "success";
            message = "處理中…";
            await InvokeAsync(StateHasChanged);
            await action();
            message = success;
        }
        catch (Exception exception)
        {
            messageClass = "error";
            message = exception.Message;
        }
        finally
        {
            isBusy = false;
            uiOperationLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string RunStatusText(ScheduleRunDto run) => run.Status == ScheduleRunStatus.TimeLimit && string.IsNullOrWhiteSpace(run.Error) ? "時限到，已產生合法班表" : run.Status switch { ScheduleRunStatus.Queued => "已送出，等待處理", ScheduleRunStatus.Running => "處理中", _ => run.Status.ToString() };
    private static string ObjectiveText(string name) => name switch { "RequestedRest" => "指定休假", "ScheduleQualityAndFairness" => "排班品質與公平性", "StaffingQuality" => "班組人力品質", "RestDistribution" => "休假分布", "WorkPatternQuality" => "工作型態品質", "RestFairness" => "休假公平", _ => name };
    private static string ComponentText(string name) => name switch { "RequestedRest" => "未滿足 R*", "UnusedLeaveRest" => "未使用指定 R休額度", "ExternalStaffing" => "外援人力", "MonthlyRest" => "每月一般 R 偏差", "SpecialRestBalance" => "八週累積 R1 餘額", "WorkStreak" => "連續工作區段", "MixedShiftWorkStreak" => "連續工作區段混合班型", "NightRestEarly" => "夜R早", "NightRestAfternoon" => "夜R午", "ShiftChangeWithoutRest" => "未休假直接換班", "WeekdayRestFairness" => "平日休假公平", "HolidayRestFairness" => "假日休假公平", "EarlyAfternoonImbalance" => "早午班差距", "NightShiftTarget" => "夜班 3, 4 天目標", "NonMonthlyShift" => "月班別不一致", "Attendance" => "班組出勤不足", "Specialty" => "專業缺席", "Ability" => "高能力人員不足", "NightToEarlyRest" => "跨月夜轉早休假不足", "MonthBoundaryRestBalance" => "月交界休假不平衡", _ => name };

    private string CellEditorValue(DemandAssignmentDto? cell)
    {
        if (cell is null) return "";
        if (cell.Kind is null && cell.RequestedRest) return "RStar";
        if (cell.Kind == "Work" && cell.Shift is "Early" or "Afternoon" or "Night") return workspaceCode == WorkspaceCode.M ? $"m:{cell.Station}:{cell.Shift}" : cell.Shift;
        if (cell.Kind != "WorkEvent") return "Existing";
        var start = LocalText(cell.EventStart);
        var end = LocalText(cell.EventEnd);
        var match = configuration?.NonStandardShifts.FirstOrDefault(x => start is not null && end is not null &&
                                                                         TimeOnly.FromDateTime(start.Value) == x.StartTime && TimeOnly.FromDateTime(end.Value) == x.EndTime);
        return match is null ? "Other" : $"ns:{match.Code}";
    }

    private static string CellClass(DemandAssignmentDto? cell) => cell?.Kind switch { "Rest" or "SpecialRest" or "LeaveRest" => "rest", "Work" when cell.Shift == "Early" => "early", "Work" when cell.Shift == "Afternoon" => "afternoon", "Work" when cell.Shift == "Night" => "night", "WorkEvent" => "event", _ => cell?.RequestedRest == true ? "requested" : "" };
    private static string Taipei(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm");


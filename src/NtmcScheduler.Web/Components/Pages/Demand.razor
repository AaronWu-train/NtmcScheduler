@page "/{Workspace}/demand"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDemandService DemandService
@inject IScheduleRunService RunService
@inject IScheduleService ScheduleService
@inject IMPerpetualScheduleService PerpetualService
@inject ICommonConfigurationService ConfigurationService
@inject IEmployeeDemandSubmissionService SubmissionService
@inject CurrentActorService CurrentActor
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@workspaceCode 建立班表</PageTitle>
<WorkspaceNav Workspace="@Workspace.ToLowerInvariant()"/>
<div class="page-title">
    <div>
        <h1>@workspaceCode 建立班表</h1>
        <p>依序準備上月班表、編輯本月需求，再開始求解。</p>
    </div>
    <PageHelp Title="建立班表說明">
        <p>每次求解只讀取當下需求，產生的班表會獨立保存。系統優先使用上月已採用班表；若不存在，請上傳完整上月班表。</p>
    </PageHelp>
</div>
@if (message is not null)
{
    <p class="alert @messageClass" role="status">@message</p>
}
<div class="toolbar">
    <label>
        月份
        <select class="month-selector" value="@selectedMonth" @onchange="SelectMonthAsync">
            @foreach (var month in availableMonths)
            {
                <option value="@MonthValue(month)">@MonthLabel(month)</option>
            }
            @if (canEdit)
            {
                <option value="new">新增月份…</option>
            }
        </select>
    </label>
    @if (selectedMonth == "new")
    {
        <input aria-label="新增月份" type="month" value="@monthText" @onchange="ChangeMonth"/>
        <button class="primary" disabled="@isBusy" @onclick="CreateAsync">@(isBusy ? "處理中…" : "新增月份")</button>
    }
</div>

@if (demand is not null)
{
    <nav class="wizard-steps" aria-label="建立班表步驟">
        <button class="@(activeStep == 1 ? "active" : "")" @onclick="() => activeStep = 1">1 選擇月份</button>
        <button class="@(activeStep == 2 ? "active" : "")" @onclick="() => activeStep = 2">2 準備上月班表</button>
        <button class="@(activeStep == 3 ? "active" : "")" @onclick="() => activeStep = 3">3 需求編輯器</button>
        <button class="@(activeStep == SolveStep ? "active" : "")" @onclick="() => activeStep = SolveStep">4 執行求解</button>
    </nav>

    @if (activeStep == 1)
    {
        <section class="card">
            <h2>@MonthLabel(demand.Month)</h2>
            <p>最後儲存：@Taipei(demand.UpdatedAtUtc)</p>
            @if (canEdit)
            {
                <button class="danger" disabled="@isBusy" @onclick="DeleteDemandAsync">@(isBusy ? "處理中…" : "刪除本月需求")</button>
            }
            <div class="step-actions">
                <span></span><button class="primary" @onclick="() => activeStep = 2">下一步：準備上月班表</button>
            </div>
        </section>
    }
    else if (activeStep == 2)
    {
        <section class="card">
            <h2>上月班表</h2>
            <p>目前來源：<strong>@PreviousLabel()</strong></p>
            <p class="format-help">從下拉清單選擇資料庫班表或上傳班表。上傳檔只作這次建立班表的歷史來源，不會建立資料庫班表版本。</p>
            <div class="toolbar">
                <label>
                    上月班表來源
                    <select value="@PreviousSourceValue" disabled="@(!canEdit || isBusy)" @onchange="SelectPreviousVersionAsync">
                        <option value="" disabled>請選擇上月班表來源</option><option value="upload">（採用上傳班表）</option>
                        @foreach (var option in previousOptions)
                        {
                            <option value="@option.Id">@PreviousOptionText(option)</option>
                        }
                    </select>
                </label>
            </div>
            @if (IsUploadPreviousSelected)
            {
                <div class="toolbar">
                    <a class="button-link" href="/download/templates/@Workspace.ToLowerInvariant()/previous.csv">下載範本</a>
                    @if (canEdit)
                    {
                        <label class="button-link primary file-upload-button">上傳上月班表<InputFile OnChange="UploadPreviousAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                    }
                </div>
                @if (demand.PreviousUpload is not null)
                {
                    <p>檔名：@demand.PreviousUpload.FileName　上傳時間：@Taipei(demand.PreviousUpload.UploadedAtUtc)</p>
                    <div class="toolbar">
                        <button @onclick="OpenPreviousPreviewAsync">預覽</button><a class="button-link" href="/download/demands/@(demand.Id)/previous.csv">下載 CSV</a>
                    </div>
                }
            }
            else if (previousVersion is not null)
            {
                <p>班表：@previousVersion.Name　建立時間：@Taipei(previousVersion.CreatedAtUtc)</p>
                <div class="toolbar">
                    <button @onclick="OpenPreviousPreviewAsync">預覽</button><a class="button-link" href="/download/demands/@(demand.Id)/previous.csv">下載 CSV</a>
                </div>
            }
            @if (workspaceCode == WorkspaceCode.M)
            {
                <hr/>
                <h2>M 八週萬年班表</h2>
                <p>目前來源：<strong>@PerpetualSourceLabel()</strong></p>
                <p class="format-help">選填。未上傳本月份暫用檔案時，自動使用 M 班表列表保存的全域萬年班表；兩者都沒有時仍可求解。</p>
                <div class="toolbar">
                    <a class="button-link" href="/download/templates/m/perpetual.csv">下載範本</a>
                    @if (canEdit)
                    {
                        <label class="button-link primary file-upload-button">上傳萬年班表<InputFile OnChange="UploadPerpetualAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                    }
                </div>
                @if (demand.PerpetualUpload is not null)
                {
                    <p>檔名：@demand.PerpetualUpload.FileName　上傳時間：@Taipei(demand.PerpetualUpload.UploadedAtUtc)</p>
                    <div class="toolbar">
                        <a class="button-link" target="_blank" href="/demands/@(demand.Id)/perpetual.csv">開啟班表</a>
                        <a class="button-link" href="/download/demands/@(demand.Id)/perpetual.csv">下載 CSV</a>
                        @if (canEdit)
                        {
                            <button disabled="@isBusy" @onclick="UseGlobalPerpetualAsync">改用全域萬年班表</button>
                        }
                    </div>
                }
                else if (globalPerpetual is not null)
                {
                    <p>全域檔名：@globalPerpetual.FileName　最後修改：@Taipei(globalPerpetual.UpdatedAtUtc)</p>
                    <div class="toolbar">
                        <a class="button-link" target="_blank" href="/m/perpetual.csv">開啟班表</a>
                        <a class="button-link" href="/download/m/perpetual.csv">下載 CSV</a>
                    </div>
                }
            }
            <div class="step-actions">
                <button @onclick="() => activeStep = 1">上一步</button><button class="primary" @onclick="() => activeStep = 3">下一步：需求編輯器</button>
            </div>
        </section>
    }
    else if (activeStep == 3)
    {
        <section class="card compact-card">
            <div class="section-heading">
                <div>
                    <h2>需求編輯器</h2>
                    <p>直接編輯 demand.csv 的人員欄位與每日需求。</p>
                </div>
                <div class="toolbar">
                    <a class="button-link" href="/download/templates/@Workspace.ToLowerInvariant()/demand.csv">下載需求範本</a>
                    @if (canEdit)
                    {
                        @if (CanRestorePreviousInheritedFields)
                        {
                            <button disabled="@isBusy" @onclick="RestorePreviousInheritedFieldsAsync">@(workspaceCode == WorkspaceCode.M ? "還原上月 R/R1 與萬年班表" : "還原上月 R/R1")</button>
                        }
                        <label class="button-link file-upload-button primary">匯入需求 CSV<InputFile OnChange="PreviewDemandAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                        <button disabled="@isBusy" @onclick="PreviewSubmissionImportAsync">匯入員工填報</button>
                    }
                </div>
            </div>
        </section>
        @if (preview is not null)
        {
            <section class="card">
                <h2>需求匯入預覽</h2>
                @foreach (var error in preview.Errors)
                {
                    <p class="error-text">@error</p>
                }
                @foreach (var difference in preview.Differences)
                {
                    <p>@difference</p>
                }
                <div class="step-actions">
                    <button disabled="@isBusy" @onclick="CancelPreview">取消匯入</button>
                    @if (preview.IsValid)
                    {
                        <button class="primary" disabled="@isBusy" @onclick="ConfirmDemandImportAsync">@(isBusy ? "處理中…" : "確認匯入需求")</button>
                    }
                </div>
            </section>
        }
        @if (submissionPreview is not null)
        {
            <section class="card">
                <h2>員工填報匯入預覽</h2>
                <p>填報 @submissionPreview.SubmissionCount 筆，可匯入 @submissionPreview.MatchedEmployeeCount 位員工。</p>
                @foreach (var error in submissionPreview.Errors)
                {
                    <p class="error-text">@error</p>
                }
                @foreach (var difference in submissionPreview.Differences)
                {
                    <p>@difference</p>
                }
                <div class="step-actions">
                    <button disabled="@isBusy" @onclick="CancelSubmissionPreview">取消</button>
                    @if (submissionPreview.IsValid)
                    {
                        <button class="primary" disabled="@isBusy" @onclick="ConfirmSubmissionImportAsync">@(isBusy ? "處理中…" : "確認匯入員工填報")</button>
                    }
                </div>
            </section>
        }

        <section class="card">
            <div class="section-heading">
                <h2>@MonthLabel(demand.Month) 需求</h2><span>欄位變更後自動儲存</span>
            </div>
            <div class="table-scroll schedule-grid">
                <table class="demand-table">
                    <thead>
                    <tr>
                        @foreach (var header in InputHeaders)
                        {
                            <th class="@HeaderClass(header) @DayClass(header)">
                                @if (header is "ID" or "姓名" or "所屬" or "T月班別")
                                {
                                    <button class="sort-button" @onclick="() => SortBy(header)" aria-label="依 @header 排序">
                                        @header <span aria-hidden="true">@SortMark(header)</span>
                                    </button>
                                }
                                else
                                {
                                    @HeaderText(header)
                                }
                            </th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var employee in SortedEmployees())
                    {
                        var edit = employeeEdits[employee.EmployeeCode];
                        <tr>
                            @foreach (var header in InputHeaders)
                            {
                                var column = ScheduleCsv.MonthlyHeaders.ToList().IndexOf(header);
                                var value = employee.MonthlyCsvValues[column];
                                if (TryDay(header, out var day))
                                {
                                    if (day > DateTime.DaysInMonth(demand.Month.Year, demand.Month.Month))
                                    {
                                        <td></td>
                                    }
                                    else
                                    {
                                        var date = demand.Month.AddDays(day - 1);
                                        var cell = employee.Assignments.FirstOrDefault(x => x.Date == date);
                                        <td class="@DayClass(header)">
                                            <select class="cell-editor @CellClass(cell)" title="@value" disabled="@(!canEdit || isBusy || employee.EmploymentStartDate is { } start && date < start)" value="@CellEditorValue(cell)" @onchange="args => ChangeCellAsync(employee, date, cell, args.Value?.ToString())">
                                                <option value=""></option><option value="RStar">R*</option>
                                                @if (workspaceCode == WorkspaceCode.M)
                                                {
                                                    @foreach (var station in MStations)
                                                    {
                                                        <option value="m:@station:Early">@ShortStation(station)早</option>
                                                        <option value="m:@station:Afternoon">@ShortStation(station)小</option>
                                                        <option value="m:@station:Night">@ShortStation(station)夜</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="Early">早</option>
                                                    <option value="Afternoon">午</option>
                                                    <option value="Night">夜</option>
                                                }
                                                @if (cell is not null && CellEditorValue(cell) == "Existing")
                                                {
                                                    <option value="Existing" disabled>@value</option>
                                                }
                                                <optgroup label="非常態班型">
                                                    <option value="Other">自行輸入 X…</option>
                                                    @foreach (var shift in configuration?.NonStandardShifts ?? [])
                                                    {
                                                        <option value="ns:@shift.Code">@(shift.Name ?? shift.Code)</option>
                                                    }
                                                </optgroup>
                                            </select>
                                        </td>
                                    }
                                }
                                else if (header == "到職日期")
                                {
                                    <td>
                                        <input class="inline-field date-field" type="date" disabled="@(!canEdit || isBusy)" value="@DateText(edit.EmploymentStartDate)" @onchange='args => ChangeEmployeeFieldAsync(employee, edit, "employmentStart", args.Value?.ToString())'/>
                                    </td>
                                }
                                else if (header == "T月班別" && workspaceCode == WorkspaceCode.T)
                                {
                                    <td>
                                        <select class="inline-field" disabled="@(!canEdit || isBusy)" value="@edit.MonthlyShift" @onchange='args => ChangeEmployeeFieldAsync(employee, edit, "monthlyShift", args.Value?.ToString())'>
                                            <option value="Early">早</option><option value="Afternoon">午</option><option value="Night">夜</option>
                                        </select>
                                    </td>
                                }
                                else if (header == "月初區間累計R")
                                {
                                    <td>
                                        <input class="inline-field number-field" type="number" min="0" disabled="@(!canEdit || isBusy)" value="@edit.OpeningRest" @onchange='args => ChangeEmployeeFieldAsync(employee, edit, "openingRest", args.Value?.ToString())'/>
                                    </td>
                                }
                                else if (header == "月初區間累計R1")
                                {
                                    <td>
                                        <input class="inline-field number-field" type="number" min="0" disabled="@(!canEdit || isBusy)" value="@edit.OpeningSpecialRest" @onchange='args => ChangeEmployeeFieldAsync(employee, edit, "openingSpecialRest", args.Value?.ToString())'/>
                                    </td>
                                }
                                else if (header == "當月指定R休")
                                {
                                    <td>
                                        <input class="inline-field number-field" type="number" min="0" disabled="@(!canEdit || isBusy)" value="@edit.LeaveRest" @onchange='args => ChangeEmployeeFieldAsync(employee, edit, "leaveRest", args.Value?.ToString())'/>
                                    </td>
                                }
                                else if (header == "萬年班表" && workspaceCode == WorkspaceCode.M)
                                {
                                    <td>
                                        <input class="inline-field perpetual-field" disabled="@(!canEdit || isBusy)" value="@edit.PerpetualId" @onchange='args => ChangeEmployeeFieldAsync(employee, edit, "perpetual", args.Value?.ToString())'/>
                                    </td>
                                }
                                else
                                {
                                    <td class="@StickyClass(header)">@value</td>
                                }
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <div class="step-actions">
            <button @onclick="() => activeStep = 2">上一步</button><button class="primary" @onclick="() => activeStep = SolveStep">下一步：執行求解</button>
        </div>
    }
    else if (activeStep == SolveStep)
    {
        <section class="card">
            <div class="section-heading">
                <div>
                    <h2>執行求解</h2>
                    <p>使用目前需求產生可編輯的班表候選。</p>
                </div>
                @if (canEdit)
                {
                    <button class="primary" disabled="@isBusy" @onclick="QueueAsync">@(isBusy ? "處理中…" : "開始求解")</button>
                }
            </div>
            <div class="advanced-settings">
                <strong>進階求解設定</strong>
                <div class="toolbar">
                    <label>每次時間上限（秒）<input class="number-field" type="number" min="1" @bind="solveTimeLimitSeconds"/></label><label>平行運算數<input class="number-field" type="number" min="1" @bind="solveWorkerCount"/></label>
                    @if (workspaceCode == WorkspaceCode.M)
                    {
                        <label>Seed數量<input class="number-field" type="number" min="1" @bind="solveSeedCount"/></label>
                    }
                </div>
            </div>
            <h3 class="solve-history-title">最近求解工作</h3>
            <div class="table-scroll">
                <table>
                    <thead>
                    <tr>
                        <th>建立時間</th><th>狀態</th><th>參數</th><th>完成時間</th><th>詳細資訊</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in runs)
                    {
                        <tr>
                            <td>@Taipei(run.CreatedAtUtc)</td><td>@RunStatusText(run)</td><td>@run.TimeLimitSeconds 秒／@run.WorkerCount workers／@run.SeedCount seeds</td><td>@(run.CompletedAtUtc is null ? "" : Taipei(run.CompletedAtUtc.Value))</td><td>
                                @if (!string.IsNullOrWhiteSpace(run.Error))
                                {
                                    <details class="solve-details">
                                        <summary>錯誤詳細資訊</summary>

                                        <div class="solve-error-block">
                                            <button type="button"
                                                    class="copy-error-btn"
                                                    @onclick="() => CopyErrorAsync(run.Error)">
                                                複製
                                            </button>

                                            <pre class="solve-error-text">@run.Error</pre>
                                        </div>
                                    </details>
                                }
                                @foreach (var candidate in run.Candidates)
                                {
                                    <details class="solve-details">
                                        <summary>候選 @candidate.Number 詳細資訊</summary>
                                        @foreach (var objective in candidate.Objectives)
                                        {
                                            <div>優先層級 @objective.Priority－@ObjectiveText(objective.Name)：總加權分 @objective.Value</div>
                                            @foreach (var component in objective.Components)
                                            {
                                                <div class="solve-component">@ComponentText(component.Name)：違反量 @component.Value，權重 @component.Weight，加權分 @(component.Value * component.Weight)</div>
                                            }
                                        }
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="step-actions">
                <button @onclick="() => activeStep = 3">上一步</button><a class="button-link" href="/">查看 Dashboard</a>
            </div>
        </section>
    }
}

@if (editingCellEmployee is not null)
{
    <div class="modal-backdrop"></div>
    <section class="editor-dialog" role="dialog" aria-modal="true">
        <h2>@editingCellEmployee.EmployeeCode／@editingDate.ToString("yyyy-MM-dd") 其他班型</h2>
        <label>開始<input type="datetime-local" @bind="cellEdit.Start"/></label><label>結束<input type="datetime-local" @bind="cellEdit.End"/></label><label>說明<input maxlength="500" @bind="cellEdit.Description"/></label>
        <div class="step-actions">
            <button disabled="@isBusy" @onclick="CloseEditors">取消</button><button class="primary" disabled="@isBusy" @onclick="SaveOtherCellAsync">@(isBusy ? "處理中…" : "儲存 X")</button>
        </div>
    </section>
}

@if (previousSchedulePreview is not null)
{
    <div class="modal-backdrop"></div>
    <section class="previous-preview-dialog" role="dialog" aria-modal="true" aria-label="上月班表預覽">
        <header>
            <h2>上月班表預覽</h2><button @onclick="ClosePreviousPreview">關閉</button>
        </header>
        <div class="table-scroll schedule-grid compact-schedule">
            <table>
                <thead>
                <tr>
                    <th class="sticky-col sticky-id">ID</th><th class="sticky-col sticky-name">姓名</th><th class="sticky-col sticky-affiliation">所屬</th>
                    @foreach (var day in PreviousDays())
                    {
                        <th class="day-header">
                            <span>@day</span>
                        </th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var employee in previousSchedulePreview.Employees)
                {
                    <tr>
                        <td class="sticky-col sticky-id">@employee.EmployeeCode</td><td class="sticky-col sticky-name">@employee.Name</td><td class="sticky-col sticky-affiliation">@employee.Affiliation</td>
                        @foreach (var day in PreviousDays())
                        {
                            <td class="day-cell">@employee.MonthlyCsvValues[7 + day]</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter] public string Workspace { get; set; } = "";
    private WorkspaceCode workspaceCode;
    private string monthText = DateTime.Today.ToString("yyyy-MM");
    private string selectedMonth = "new";
    private bool canEdit;
    private int activeStep = 1;
    private IReadOnlyList<DateOnly> availableMonths = [];
    private int SolveStep => 4;
    private DemandDraftDto? demand;
    private ConfigurationRevisionDto? configuration;
    private IReadOnlyList<ScheduleRunDto> runs = [];
    private PreviousSchedulePreviewDto? previousSchedulePreview;
    private MPerpetualScheduleDto? globalPerpetual;
    private ScheduleVersionDto? previousVersion;
    private IReadOnlyList<ScheduleVersionDto> previousOptions = [];
    private string? message;
    private string messageClass = "success";
    private byte[]? pendingDemand;
    private ImportPreviewDto? preview;
    private SubmissionImportPreviewDto? submissionPreview;
    private bool isBusy;
    private int solveTimeLimitSeconds = 300;
    private int solveWorkerCount = 8;
    private int solveSeedCount = 1;
    private string sortColumn = "ID";
    private bool sortDescending;
    private bool pendingUploadPreviousSource;
    private Dictionary<string, EmployeeEdit> employeeEdits = [];
    private DemandEmployeeDto? editingCellEmployee;
    private DateOnly editingDate;
    private readonly CellEdit cellEdit = new();
    private readonly System.Threading.SemaphoreSlim uiOperationLock = new(1, 1);

    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<WorkspaceCode>(Workspace, true, out workspaceCode)) throw new DomainValidationException("工作區只支援 M 或 T。");
        solveWorkerCount = workspaceCode == WorkspaceCode.M ? 4 : 8;
        solveSeedCount = workspaceCode == WorkspaceCode.M ? 2 : 1;
        var actor = await CurrentActor.GetAsync();
        if (!actor.CanEdit(workspaceCode))
        {
            Navigation.NavigateTo("/Account/AccessDenied", replace: true);
            return;
        }
        canEdit = actor.CanEdit(workspaceCode) && !actor.MustChangePassword;
        availableMonths = await DemandService.ListMonthsAsync(workspaceCode, actor);
        var initial = availableMonths.FirstOrDefault(x => MonthValue(x) == monthText);
        if (initial == default) initial = availableMonths.FirstOrDefault();
        if (initial == default)
        {
            selectedMonth = "new";
            demand = null;
            configuration = null;
            previousVersion = null;
            previousOptions = [];
            runs = [];
            ClearLocalDemandEdits();
            pendingUploadPreviousSource = false;
            globalPerpetual = workspaceCode == WorkspaceCode.M ? await PerpetualService.GetAsync(actor) : null;
            return;
        }

        selectedMonth = monthText = MonthValue(initial);
        await LoadAsync();
    }

    private DateOnly Month() => DateOnly.ParseExact(monthText + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture);
    private void ChangeMonth(ChangeEventArgs args) => monthText = args.Value?.ToString() ?? monthText;

    private async Task SelectMonthAsync(ChangeEventArgs args)
    {
        selectedMonth = args.Value?.ToString() ?? "new";
        if (selectedMonth == "new")
        {
            demand = null;
            configuration = null;
            previousVersion = null;
            previousOptions = [];
            runs = [];
            ClearLocalDemandEdits();
            pendingUploadPreviousSource = false;
            activeStep = 1;
            return;
        }

        monthText = selectedMonth;
        await LoadAsync();
        activeStep = 2;
    }

    private async Task LoadAsync()
    {
        var actor = await CurrentActor.GetAsync();
        demand = await DemandService.GetAsync(workspaceCode, Month(), actor);
        configuration = demand is null ? null : await ConfigurationService.GetRevisionAsync(demand.ConfigurationRevisionId, actor);
        globalPerpetual = workspaceCode == WorkspaceCode.M ? await PerpetualService.GetAsync(actor) : null;
        previousOptions = demand is null ? [] : await ScheduleService.ListVersionsAsync(workspaceCode, demand.Month.AddMonths(-1), actor);
        previousVersion = demand?.PreviousScheduleVersionId is { } selectedId
            ? previousOptions.FirstOrDefault(x => x.Id == selectedId)
            : null;
        InitializeEmployeeEdits();
        await LoadRunsAsync();
        submissionPreview = null;
    }


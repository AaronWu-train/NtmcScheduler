    private static readonly HashSet<string> PostSolveHeaders = ["當月R", "當月R1", "月底區間累計R", "月底區間累計R1", "本月班數"];
    private static readonly string[] MStations = ["LB01", "LB02", "LB03", "LB04", "LB05", "LB06", "LB07", "LB08", "LB09", "LB10", "LB11", "LB12"];
    private static string StickyClass(string header) => header switch { "ID" => "sticky-col sticky-id", "姓名" => "sticky-col sticky-name", "所屬" => "sticky-col sticky-affiliation", _ => "" };
    private string HeaderClass(string header) => StickyClass(header) + (header is "ID" or "姓名" or "所屬" or "T月班別" ? " sortable" : "");
    private static string HeaderText(string header) => header switch { "到職日期" => "本月到職", "月初區間累計R" => "月初R", "月初區間累計R1" => "月初R1", "當月指定R休" => "R休上限", "T月班別" => "月班別", "萬年班表" => "萬年班表", _ => header };

    private string DayClass(string header)
    {
        if (!TryDay(header, out var day) || demand is null) return "";
        var date = demand.Month.AddDays(day - 1);
        var holiday = configuration?.RestIntervals.SelectMany(x => x.NationalHolidays).Contains(date) == true;
        var boundary = configuration?.RestIntervals.Any(x => x.Start == date) == true;
        return (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday || holiday ? "holiday-column " : "") + (boundary ? "interval-boundary" : "");
    }

    private IEnumerable<DemandEmployeeDto> SortedEmployees()
    {
        Func<DemandEmployeeDto, string> key = sortColumn switch
        {
            "姓名" => x => x.Name,
            "所屬" => x => x.Affiliation,
            "T月班別" => x => x.MonthlyShift switch { "Early" => "0", "Afternoon" => "1", "Night" => "2", _ => "3" },
            _ => x => x.EmployeeCode
        };
        var ordered = sortDescending ? demand!.Employees.OrderByDescending(key, StringComparer.OrdinalIgnoreCase) : demand!.Employees.OrderBy(key, StringComparer.OrdinalIgnoreCase);
        return ordered.ThenBy(x => x.EmployeeCode, StringComparer.OrdinalIgnoreCase);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column) sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
    }

    private string SortMark(string column) => sortColumn == column ? sortDescending ? "▼" : "▲" : "";

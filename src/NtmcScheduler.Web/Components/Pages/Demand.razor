    private static bool TryDay(string header, out int day) => int.TryParse(header, NumberStyles.None, CultureInfo.InvariantCulture, out day);

    private IReadOnlyList<string> InputHeaders => ScheduleCsv.MonthlyHeaders.Where(header => !PostSolveHeaders.Contains(header) &&
                                                                                             (workspaceCode == WorkspaceCode.T || header is not "能力" and not "T月班別") &&
                                                                                             (workspaceCode == WorkspaceCode.M || header != "萬年班表") &&

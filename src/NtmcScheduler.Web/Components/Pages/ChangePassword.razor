@page "/Account/ChangePassword"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using NtmcScheduler.Infrastructure.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NtmcDbContext Db
@inject IdentityRedirectManager Redirect

<PageTitle>修改密碼</PageTitle>
<div class="page-title">
    <div>
        <h1>修改密碼</h1>
        <p>首次登入或密碼重設後必須先完成此步驟。</p>
    </div>
    <PageHelp Title="密碼說明">
        <p>密碼至少 8 字元、至少 2 種不同字元，並包含數字。</p>
    </PageHelp>
</div>
<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="card narrow-form">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    @if (error is not null)
    {
        <p class="alert error" role="alert">@error</p>
    }
    <label for="current">目前或一次性密碼</label>
    <InputText id="current" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password"/>
    <label for="new">新密碼</label>
    <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password"/>
    <label for="confirm">確認新密碼</label>
    <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password"/>
    <button type="submit" class="primary">更新密碼</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = default!;
    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Redirect.RedirectTo("/Account/Login");
            return;
        }

        await using var transaction = await Db.Database.BeginTransactionAsync();
        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            error = string.Join("；", result.Errors.Select(x => x.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);
        var actor = ActorContextFactory.FromHttp(HttpContext, HttpContext.User);
        AuditWriter.Add(Db, actor, "PasswordChanged", null, "User", user.Id, null, null);
        await Db.SaveChangesAsync();
        await transaction.CommitAsync();
        var sessionId = ActorContextFactory.ParseSessionId(HttpContext.User);
        await SignInManager.SignOutAsync();
        var claims = sessionId is null ? Array.Empty<Claim>() : new[] { new Claim(AuditClaimTypes.SessionId, sessionId.Value.ToString("N")) };
        await SignInManager.SignInWithClaimsAsync(user, isPersistent: false, claims);
        Redirect.RedirectTo("/");
    }

    private sealed class PasswordInput
    {
        [Required, DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = "";

        [Required, MinLength(8), DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [Compare(nameof(NewPassword), ErrorMessage = "兩次輸入的新密碼不一致。"), DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = "";
    }

}

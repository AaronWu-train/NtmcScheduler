@page "/Account/Login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NtmcDbContext Db
@inject LoginRateLimiter RateLimiter
@inject IdentityRedirectManager Redirect

<PageTitle>登入</PageTitle>
<div class="page-title"><div><h1>登入</h1><p>使用管理者核發的帳號登入。</p></div><PageHelp Title="登入說明"><p>本系統不開放自行註冊或忘記密碼。忘記密碼時請由管理者重設一次性密碼；首次登入後必須立即修改。</p></PageHelp></div>
<EditForm EditContext="editContext" method="post" OnSubmit="LoginAsync" FormName="login" class="card narrow-form">
    <DataAnnotationsValidator />
    <ValidationSummary />
    @if (error is not null) { <p class="alert error" role="alert">@error</p> }
    <label for="username">帳號</label>
    <InputText id="username" @bind-Value="Input.UserName" autocomplete="username" />
    <label for="password">密碼</label>
    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
    <button type="submit" class="primary">登入</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private EditContext editContext = default!;
    private string? error;

    protected override void OnInitialized()
    {
        Input ??= new();
        editContext = new(Input);
    }

    private async Task LoginAsync()
    {
        if (!editContext.Validate()) return;
        var ip = HttpContext.Connection.RemoteIpAddress?.ToString();
        if (!RateLimiter.IsAllowed(Input.UserName, ip, DateTimeOffset.UtcNow))
        {
            await AuditAsync(null, "LoginRateLimited", Input.UserName, ip);
            error = "帳號或密碼錯誤，或暫時無法登入。";
            return;
        }

        await using var transaction = await Db.Database.BeginTransactionAsync();
        var user = await UserManager.FindByNameAsync(Input.UserName);
        var result = user is null || user.IsDisabled
            ? SignInResult.Failed
            : await SignInManager.PasswordSignInAsync(user, Input.Password, isPersistent: false, lockoutOnFailure: true);
        await AuditAsync(user?.Id, result.Succeeded ? "LoginSucceeded" : result.IsLockedOut ? "LoginLockedOut" : "LoginFailed", Input.UserName, ip);
        await transaction.CommitAsync();
        if (!result.Succeeded)
        {
            RateLimiter.RecordFailure(Input.UserName, ip, DateTimeOffset.UtcNow);
            error = "帳號或密碼錯誤，或暫時無法登入。";
            return;
        }
        RateLimiter.ResetAccount(Input.UserName);
        Redirect.RedirectTo(user!.MustChangePassword ? "/Account/ChangePassword" : ReturnUrl);
    }

    private async Task AuditAsync(Guid? userId, string action, string actorName, string? ip)
    {
        var now = DateTimeOffset.UtcNow;
        Db.AuditLogs.Add(new AuditLog
        {
            AtUtc = now,
            AtUtcTicks = now.UtcTicks,
            ActorUserId = userId,
            ActorName = actorName.Trim(),
            Action = action,
            ResourceType = "Authentication",
            ResourceId = userId?.ToString() ?? "unknown",
            Succeeded = action == "LoginSucceeded",
            IpAddress = ip,
            UserAgent = HttpContext.Request.Headers.UserAgent.ToString(),
            CorrelationId = HttpContext.TraceIdentifier
        });
        await Db.SaveChangesAsync();
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "請輸入帳號。"), StringLength(100)] public string UserName { get; set; } = "";
        [Required(ErrorMessage = "請輸入密碼。"), DataType(DataType.Password)] public string Password { get; set; } = "";
    }
}

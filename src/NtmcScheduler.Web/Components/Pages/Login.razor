@page "/Account/Login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using NtmcScheduler.Infrastructure.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NtmcDbContext Db
@inject LoginRateLimiter RateLimiter
@inject IdentityRedirectManager Redirect

<PageTitle>登入</PageTitle>
<div class="page-title">
    <div>
        <h1>登入</h1>
        <p>使用管理者核發的帳號登入。</p>
    </div>
    <PageHelp Title="登入說明">
        <p>本系統不開放自行註冊或忘記密碼。忘記密碼時請由管理者重設一次性密碼；首次登入後必須立即修改。之後可從頁首「修改密碼」自行更換。</p>
    </PageHelp>
</div>
<EditForm EditContext="editContext" method="post" OnSubmit="LoginAsync" FormName="login" class="card narrow-form">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    @if (error is not null)
    {
        <p class="alert error" role="alert">@error</p>
    }
    <label for="username">帳號</label>
    <InputText id="username" @bind-Value="Input.UserName" autocomplete="username"/>
    <label for="password">密碼</label>
    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password"/>
    <button type="submit" class="primary">登入</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private EditContext editContext = default!;
    private string? error;

    protected override void OnInitialized()
    {
        Input ??= new();
        editContext = new(Input);
    }

    private async Task LoginAsync()
    {
        if (!editContext.Validate()) return;
        var ip = HttpContext.Connection.RemoteIpAddress?.ToString();
        if (!RateLimiter.IsAllowed(Input.UserName, ip, DateTimeOffset.UtcNow))
        {
            await AuditAsync(null, "LoginRateLimited", Input.UserName, ip, null);
            error = "帳號或密碼錯誤，或暫時無法登入。";
            return;
        }

        await using var transaction = await Db.Database.BeginTransactionAsync();
        var user = await UserManager.FindByNameAsync(Input.UserName);
        SignInResult result;
        Guid? sessionId = null;
        if (user is null || user.IsDisabled)
            result = SignInResult.Failed;
        else
        {
            result = await SignInManager.CheckPasswordSignInAsync(user, Input.Password, lockoutOnFailure: true);
            if (result.Succeeded)
            {
                sessionId = ActorContextFactory.NewSessionId();
                await SignInManager.SignInWithClaimsAsync(user, isPersistent: false,
                    [new Claim(AuditClaimTypes.SessionId, sessionId.Value.ToString("N"))]);
            }
        }

        var action = result.Succeeded ? "LoginSucceeded" : result.IsLockedOut ? "LoginLockedOut" : "LoginFailed";
        await AuditAsync(user?.Id, action, Input.UserName, ip, sessionId);
        await transaction.CommitAsync();
        if (!result.Succeeded)
        {
            RateLimiter.RecordFailure(Input.UserName, ip, DateTimeOffset.UtcNow);
            error = "帳號或密碼錯誤，或暫時無法登入。";
            return;
        }

        RateLimiter.ResetAccount(Input.UserName);
        Redirect.RedirectTo(user!.MustChangePassword ? "/Account/ChangePassword" : ReturnUrl);
    }

    private async Task AuditAsync(Guid? userId, string action, string actorName, string? ip, Guid? sessionId)
    {
        var actor = new ActorContext(
            userId ?? Guid.Empty,
            actorName.Trim(),
            false,
            new HashSet<WorkspaceCode>(),
            HttpContext.TraceIdentifier,
            action == "LoginSucceeded" ? sessionId : null,
            ip,
            HttpContext.Request.Headers.UserAgent.ToString());
        AuditWriter.Add(Db, actor, action, null, "Authentication", userId?.ToString() ?? "unknown", null, null, action == "LoginSucceeded");
        await Db.SaveChangesAsync();
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "請輸入帳號。"), StringLength(100)]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "請輸入密碼。"), DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }

}

@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]
@inject IUserAdministrationService Service
@inject CurrentActorService CurrentActor
@inject IJSRuntime JS

<PageTitle>帳號與權限</PageTitle>
<div class="page-title">
    <div>
        <h1>帳號與權限</h1>
        <p>建立、停用與分別配置三鶯 M、三鶯 T、環狀 M、環狀 T 編輯權。</p>
    </div>
    <PageHelp Title="帳號管理說明">
        <p>系統不開放註冊。一次性密碼至少 8 字元、至少 2 種不同字元，並包含數字；使用者首次登入必須修改，之後可從頁首自行更換。停用帳號會在最長五分鐘內中止既有登入狀態。</p>
        <p>批次 CSV 必須為 UTF-8、不超過 5 MB，表頭固定為「帳號,一次性密碼,Administrator,三鶯M,三鶯T,環狀M,環狀T」，權限欄只填 1 或 0。任一列失敗時整批不建立；檔案含一次性密碼，請妥善保管並在匯入後刪除。</p>
    </PageHelp>
</div>
@if (message is not null)
{
    <p class="alert @messageClass" role="status">@message</p>
}
<EditForm Model="newUser" OnValidSubmit="CreateAsync" class="card form-grid">
    <DataAnnotationsValidator/><ValidationSummary/>
    <label>帳號<InputText @bind-Value="newUser.UserName"/></label>
    <label>一次性密碼<InputText type="password" @bind-Value="newUser.Password"/></label>
    <label><InputCheckbox @bind-Value="newUser.Administrator"/> Administrator</label>
    <label><InputCheckbox @bind-Value="newUser.M"/> 三鶯線站務 M 排班</label>
    <label><InputCheckbox @bind-Value="newUser.T"/> 三鶯線檢修 T 排班</label>
    <label><InputCheckbox @bind-Value="newUser.YM"/> 環狀線站務 M 排班</label>
    <label><InputCheckbox @bind-Value="newUser.YT"/> 環狀線檢修 T 排班</label>
    <button type="submit" class="primary" disabled="@isBusy">@(isBusy ? "處理中…" : "建立帳號")</button>
</EditForm>
<div class="card">
    <h2>批次建立帳號</h2>
    <p>上傳固定表頭的 UTF-8 CSV；權限欄以 1 表示授權、0 表示不授權。</p>
    <div class="toolbar">
        <a class="button-link" href="/download/templates/users.csv">下載範本</a>
        <label class="button-link primary file-upload-button">匯入帳號 CSV<InputFile OnChange="CreateBatchAsync" accept=".csv,text/csv" disabled="@isBusy" aria-label="匯入帳號 CSV"/></label>
    </div>
</div>
<p>停用狀態與權限勾選變更後會自動儲存。</p>
<div class="table-scroll">
    <table>
        <thead>
        <tr>
            <th>帳號</th><th>狀態</th><th>管理者</th><th>三鶯 M</th><th>三鶯 T</th><th>環狀 M</th><th>環狀 T</th><th>一次性密碼</th><th>操作</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in users)
        {
            <tr>
                <td>@row.UserName</td>
                <td>
                    <label><input type="checkbox" disabled="@isBusy" @bind="row.IsDisabled" @bind:after="() => SaveAsync(row)"/> 停用</label>
                </td>
                <td>
                    <input aria-label="@row.UserName 管理者" type="checkbox" disabled="@isBusy" @bind="row.IsAdministrator" @bind:after="() => SaveAsync(row)"/>
                </td>
                <td>
                    <input aria-label="@row.UserName M 編輯" type="checkbox" disabled="@isBusy" @bind="row.M" @bind:after="() => SaveAsync(row)"/>
                </td>
                <td>
                    <input aria-label="@row.UserName T 編輯" type="checkbox" disabled="@isBusy" @bind="row.T" @bind:after="() => SaveAsync(row)"/>
                </td>
                <td>
                    <input aria-label="@row.UserName YM 編輯" type="checkbox" disabled="@isBusy" @bind="row.YM" @bind:after="() => SaveAsync(row)"/>
                </td>
                <td>
                    <input aria-label="@row.UserName YT 編輯" type="checkbox" disabled="@isBusy" @bind="row.YT" @bind:after="() => SaveAsync(row)"/>
                </td>
                <td>
                    <input aria-label="@row.UserName 新的一次性密碼" type="password" disabled="@isBusy" @bind="row.ResetPassword" autocomplete="new-password"/> <button @onclick="() => ResetAsync(row)" disabled="@(isBusy || string.IsNullOrWhiteSpace(row.ResetPassword))">重設密碼</button>
                </td>
                <td>
                    <button class="danger" @onclick="() => DeleteAsync(row)" disabled="@isBusy">刪除帳號</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private readonly NewUserModel newUser = new();
    private readonly List<UserRow> users = [];
    private string? message;
    private string messageClass = "success";
    private bool isBusy;
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        users.Clear();
        users.AddRange((await Service.ListAsync(await CurrentActor.GetAsync())).Select(x => new UserRow(x)));
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            await Service.CreateAsync(new(newUser.UserName, newUser.Password, newUser.Administrator, Workspaces(newUser.M, newUser.T, newUser.YM, newUser.YT)), await CurrentActor.GetAsync());
            newUser.UserName = newUser.Password = "";
            newUser.Administrator = newUser.M = newUser.T = newUser.YM = newUser.YT = false;
            await ReloadAsync();
        }, "帳號已建立。");
    }

    private Task CreateBatchAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        await using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
        await Service.CreateBatchAsync(stream, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "批次帳號已建立。");

    private Task SaveAsync(UserRow row) => RunAsync(async () =>
    {
        try
        {
            await Service.UpdateAsync(row.Id, row.IsDisabled, row.IsAdministrator, Workspaces(row.M, row.T, row.YM, row.YT), row.RevisionToken, await CurrentActor.GetAsync());
        }
        catch
        {
            row.RestorePermissions();
            throw;
        }
        await ReloadAsync();
    }, $"帳號「{row.UserName}」的狀態與權限已自動儲存。");

    private Task ResetAsync(UserRow row) => RunAsync(async () =>
    {
        await Service.ResetPasswordAsync(row.Id, row.ResetPassword, row.RevisionToken, await CurrentActor.GetAsync());
        row.ResetPassword = "";
        await ReloadAsync();
    }, "一次性密碼已重設。");

    private async Task DeleteAsync(UserRow row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"確定要刪除帳號「{row.UserName}」嗎？\n\n刪除後使用者將無法登入，且無法還原。")) return;
        await RunAsync(async () =>
        {
            await Service.DeleteAsync(row.Id, row.RevisionToken, await CurrentActor.GetAsync());
            await ReloadAsync();
        }, "帳號已刪除。");
    }

    private async Task RunAsync(Func<Task> action, string success)
    {
        isBusy = true;
        messageClass = "success";
        message = "處理中…";
        await InvokeAsync(StateHasChanged);
        try
        {
            await action();
            message = success;
        }
        catch (Exception exception)
        {
            messageClass = "error";
            message = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static IReadOnlySet<WorkspaceCode> Workspaces(bool m, bool t, bool ym, bool yt)
    {
        var result = new HashSet<WorkspaceCode>();
        if (m) result.Add(WorkspaceCode.M);
        if (t) result.Add(WorkspaceCode.T);
        if (ym) result.Add(WorkspaceCode.YM);
        if (yt) result.Add(WorkspaceCode.YT);
        return result;
    }

    private sealed class NewUserModel
    {
        [Required, StringLength(100)] public string UserName { get; set; } = "";

        [Required, MinLength(8), DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool Administrator { get; set; }
        public bool M { get; set; }
        public bool T { get; set; }
        public bool YM { get; set; }
        public bool YT { get; set; }
    }

    private sealed class UserRow(UserAccountDto dto)
    {
        public Guid Id { get; } = dto.Id;
        public string UserName { get; } = dto.UserName;
        public Guid RevisionToken { get; } = dto.RevisionToken;
        public bool IsDisabled { get; set; } = dto.IsDisabled;
        public bool IsAdministrator { get; set; } = dto.IsAdministrator;
        public bool M { get; set; } = dto.EditableWorkspaces.Contains(WorkspaceCode.M);
        public bool T { get; set; } = dto.EditableWorkspaces.Contains(WorkspaceCode.T);
        public bool YM { get; set; } = dto.EditableWorkspaces.Contains(WorkspaceCode.YM);
        public bool YT { get; set; } = dto.EditableWorkspaces.Contains(WorkspaceCode.YT);
        public string ResetPassword { get; set; } = "";

        public void RestorePermissions()
        {
            IsDisabled = dto.IsDisabled;
            IsAdministrator = dto.IsAdministrator;
            M = dto.EditableWorkspaces.Contains(WorkspaceCode.M);
            T = dto.EditableWorkspaces.Contains(WorkspaceCode.T);
            YM = dto.EditableWorkspaces.Contains(WorkspaceCode.YM);
            YT = dto.EditableWorkspaces.Contains(WorkspaceCode.YT);
        }
    }

}

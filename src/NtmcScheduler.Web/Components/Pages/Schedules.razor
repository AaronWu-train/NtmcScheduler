@page "/{Workspace}/schedules"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScheduleService Service
@inject CurrentActorService CurrentActor

<PageTitle>@workspaceCode.DisplayName() 班表列表</PageTitle>
<WorkspaceNav Workspace="@Workspace.ToLowerInvariant()"/>
<div class="page-title">
    <div>
        <h1>@workspaceCode.DisplayName() 班表列表</h1>
        <p>開啟、改名、採用或封存每個月份的班表。</p>
    </div>
    <PageHelp Title="班表列表說明">
        <p>同月份可保存多份班表，最多採用一份，也可暫時不採用。所有硬規則必須先排除才能採用；已採用班表須先取消採用或改採用其他版本才能封存。</p>
    </PageHelp>
</div>
@if (message is not null)
{
    <p class="alert @messageClass" role="status">@message</p>
}
@if (workspaceCode.IsMaintenance())
{
    <section class="card">
        <div class="section-heading">
            <div>
                <h2>匯入歷史班表</h2>
                <p>指定月份後，上傳為一份可編輯的一般班表；不會自動採用或覆蓋既有版本。</p>
            </div>
            <div class="toolbar">
                <label>歷史月份<input type="month" value="@historyMonthText" @onchange="args => historyMonthText = args.Value?.ToString() ?? historyMonthText"/></label><a class="button-link" href="@($"/download/templates/{Workspace}/previous.csv")">下載範本</a>
                @if (canEdit)
                {
                    <label class="button-link primary file-upload-button">上傳歷史班表<InputFile OnChange="ImportHistoryAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                }
            </div>
        </div>
    </section>
}
@if (workspaceCode.IsStation())
{
    <section class="card">
        <div class="section-heading">
            <div>
                <h2>匯入歷史班表</h2>
                <p>指定月份後，上傳為一份可編輯的一般班表；不會自動採用或覆蓋既有版本。</p>
            </div>
            <div class="toolbar">
                <label>歷史月份<input type="month" value="@historyMonthText" @onchange="args => historyMonthText = args.Value?.ToString() ?? historyMonthText"/></label><a class="button-link" href="@($"/download/templates/{Workspace}/previous.csv")">下載範本</a>
                @if (canEdit)
                {
                    <label class="button-link primary file-upload-button">上傳歷史班表<InputFile OnChange="ImportHistoryAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                }
            </div>
        </div>
    </section>
}
<div class="month-list">
    @foreach (var month in months)
    {
        <button class="month-card @(selectedMonth == month.Month ? "selected" : "")" disabled="@isBusy" @onclick="() => SelectMonthAsync(month.Month)">
            <strong>@month.Month.ToString("yyyy-MM")</strong><span>@month.VersionCount 份班表</span><span>@(month.Adopted is null ? "尚未採用班表" : $"已採用：{month.Adopted.Name}")</span>
        </button>
    }
</div>
@if (selectedMonth is not null)
{
    <div class="table-scroll">
        <table>
            <thead>
            <tr>
                <th>狀態</th><th>班表名稱</th><th>來源</th><th>最佳化分數</th><th>建立時間</th><th>最後修改</th><th>檢查結果</th><th>操作</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var version in versions)
            {
                <tr class="@(version.IsAdopted ? "adopted-row" : "")">
                    <td>
                        @if (version.IsAdopted)
                        {
                            <span class="adopted-badge">已採用</span>
                        }
                        else
                        {
                            <span>一般班表</span>
                        }
                    </td>
                    <td>
                        @if (editingNameId == version.Id)
                        {
                            <input aria-label="班表名稱" value="@version.Name" disabled="@isBusy" @onchange="args => RenameAsync(version, args.Value?.ToString() ?? string.Empty)"/>
                            <button class="icon-button" aria-label="取消修改班表名稱" title="取消" disabled="@isBusy" @onclick="() => editingNameId = null">×</button>
                        }
                        else
                        {
                            <span class="name-actions">
                                <a href="/schedules/@version.Id">@version.Name</a>
                                @if (canEdit && !version.IsArchived)
                                {
                                    <button class="icon-button" aria-label="修改班表名稱" title="修改班表名稱" disabled="@isBusy" @onclick="() => editingNameId = version.Id">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/>
                                        </svg>
                                    </button>
                                }
                            </span>
                        }
                    </td><td>@SourceText(version.SourceStatus)</td>
                    <td class="objective-scores">
                        @foreach (var score in DisplayObjectives(version))
                        {
                            <span>J@(score.Priority)：@score.Value</span>
                        }
                        @if (!DisplayObjectives(version).Any())
                        {
                            <span>—</span>
                        }
                    </td><td>@Taipei(version.CreatedAtUtc)</td><td>@Taipei(version.UpdatedAtUtc)</td>
                    <td>
                        <span class="status @(version.HasErrors ? "warning" : version.WarningCount > 0 ? "warning" : "ok")">@(version.HasErrors ? "需要修正" : version.WarningCount > 0 ? $"建議 {version.WarningCount} 項" : "可採用")</span>
                    </td>
                    <td>
                        <div style="display: flex; gap: 12px;">

                            <a class="button-link" href="/schedules/@version.Id">開啟班表</a>
                            <a class="button-link" href="/download/schedules/@(version.Id).csv">下載 CSV</a>
                            <span><!--This is a empty div for spacings--></span>
                            @if (canEdit && version.IsAdopted)
                            {
                                <button disabled="@isBusy" @onclick="() => UnadoptAsync(version)">取消採用</button>
                            }
                            else if (canEdit && !version.IsArchived)
                            {
                                <button class="primary" disabled="@isBusy" @onclick="() => AdoptAsync(version)">採用</button>
                                <button class="danger" disabled="@isBusy" @onclick="() => ArchiveAsync(version)">封存</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@code {
    [Parameter] public string Workspace { get; set; } = "";
    private WorkspaceCode workspaceCode;
    private bool canEdit;
    private IReadOnlyList<ScheduleMonthDto> months = [];
    private IReadOnlyList<ScheduleVersionDto> versions = [];
    private DateOnly? selectedMonth;
    private string historyMonthText = DateTime.Today.ToString("yyyy-MM");
    private string? message;
    private string messageClass = "success";
    private bool isBusy;
    private Guid? editingNameId;

    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<WorkspaceCode>(Workspace, true, out workspaceCode)) throw new DomainValidationException("不支援此工作區。");
        Workspace = workspaceCode.Route();
        var actor = await CurrentActor.GetAsync();
        canEdit = actor.CanEdit(workspaceCode) && !actor.MustChangePassword;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var actor = await CurrentActor.GetAsync();
        months = await Service.ListMonthsAsync(workspaceCode, actor);
        if (selectedMonth is null && months.Count > 0) selectedMonth = months[0].Month;
        versions = selectedMonth is null ? [] : await Service.ListVersionsAsync(workspaceCode, selectedMonth.Value, actor);
    }

    private async Task SelectMonthAsync(DateOnly month)
    {
        selectedMonth = month;
        versions = await Service.ListVersionsAsync(workspaceCode, month, await CurrentActor.GetAsync());
    }

    private Task AdoptAsync(ScheduleVersionDto version) => RunAsync(async () =>
    {
        await Service.AdoptAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "已採用這份班表。");

    private Task UnadoptAsync(ScheduleVersionDto version) => RunAsync(async () =>
    {
        await Service.UnadoptAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "已取消採用這份班表。");

    private Task RenameAsync(ScheduleVersionDto version, string name) => RunAsync(async () =>
    {
        await Service.RenameAsync(version.Id, name, version.RevisionToken, await CurrentActor.GetAsync());
        editingNameId = null;
        await ReloadAsync();
    }, "班表名稱已更新。");

    private Task ArchiveAsync(ScheduleVersionDto version) => RunAsync(async () =>
    {
        await Service.ArchiveAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "班表已封存。");

    private Task ImportHistoryAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        if (!DateOnly.TryParse(historyMonthText + "-01", out var month)) throw new DomainValidationException("請選擇歷史月份。");
        var bytes = await ReadFileAsync(args.File);
        await Service.ImportAsync(workspaceCode, month, args.File.Name, new MemoryStream(bytes), await CurrentActor.GetAsync());
        selectedMonth = month;
        await ReloadAsync();
    }, "歷史班表已匯入。");

    private static IEnumerable<ObjectiveScoreDto> DisplayObjectives(ScheduleVersionDto version) => (version.Objectives ?? []).Where(score => version.Workspace.IsStation() ? score.Priority is 1 or 2 or 4 : score.Priority is >= 1 and <= 5).OrderBy(score => score.Priority);

    private async Task RunAsync(Func<Task> action, string success)
    {
        isBusy = true;
        messageClass = "success";
        message = "處理中…";
        await InvokeAsync(StateHasChanged);
        try
        {
            await action();
            message = success;
        }
        catch (Exception exception)
        {
            messageClass = "error";
            message = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static async Task<byte[]> ReadFileAsync(IBrowserFile file)
    {
        await using var input = file.OpenReadStream(5 * 1024 * 1024);
        using var memory = new MemoryStream();
        await input.CopyToAsync(memory);
        return memory.ToArray();
    }

    private static string SourceText(ScheduleRunStatus status) => status switch { ScheduleRunStatus.Imported => "上傳", ScheduleRunStatus.TimeLimit => "求解（時限到）", ScheduleRunStatus.Optimal => "求解", _ => status.ToString() };
    private static string Taipei(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm");

}

@page "/{Workspace}/schedules"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScheduleService Service
@inject IMPerpetualScheduleService PerpetualService
@inject CurrentActorService CurrentActor

<PageTitle>@workspaceCode 班表列表</PageTitle>
<WorkspaceNav Workspace="@Workspace.ToLowerInvariant()"/>
<div class="page-title">
    <div>
        <h1>@workspaceCode 班表列表</h1>
        <p>開啟、採用或封存每個月份的班表。</p>
    </div>
    <PageHelp Title="班表列表說明">
        <p>同月份可保存多份班表，但只能採用一份。所有硬規則必須先排除才能採用；目前採用的班表必須先改採用其他版本才能封存。</p>
    </PageHelp>
</div>
@if (message is not null)
{
    <p class="alert @messageClass" role="status">@message</p>
}
<div class="month-list">
    @foreach (var month in months)
    {
        <button class="month-card @(selectedMonth == month.Month ? "selected" : "")" disabled="@isBusy" @onclick="() => SelectMonthAsync(month.Month)">
            <strong>@month.Month.ToString("yyyy-MM")</strong><span>@month.VersionCount 份班表</span><span>@(month.Adopted is null ? "尚未採用班表" : $"已採用：{month.Adopted.Name}")</span>
        </button>
    }
</div>
@if (selectedMonth is not null)
{
    <div class="table-scroll">
        <table>
            <thead>
            <tr>
                <th>狀態</th><th>班表名稱</th><th>來源</th><th>最佳化分數</th><th>建立時間</th><th>最後修改</th><th>檢查結果</th><th>操作</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var version in versions)
            {
                <tr class="@(version.IsAdopted ? "adopted-row" : "")">
                    <td>
                        @if (version.IsAdopted)
                        {
                            <span class="adopted-badge">已採用</span>
                        }
                        else
                        {
                            <span>一般班表</span>
                        }
                    </td>
                    <td>
                        <a href="/schedules/@version.Id">@version.Name</a>
                    </td><td>@SourceText(version.SourceStatus)</td>
                    <td class="objective-scores">
                        @foreach (var score in DisplayObjectives(version))
                        {
                            <span>J@score.Priority：@score.Value</span>
                        }
                        @if (!DisplayObjectives(version).Any())
                        {
                            <span>—</span>
                        }
                    </td><td>@Taipei(version.CreatedAtUtc)</td><td>@Taipei(version.UpdatedAtUtc)</td>
                    <td>
                        <span class="status @(version.HasErrors ? "warning" : version.WarningCount > 0 ? "warning" : "ok")">@(version.HasErrors ? "需要修正" : version.WarningCount > 0 ? $"建議 {version.WarningCount} 項" : "可採用")</span>
                    </td>
                    <td>
                        <a class="button-link" href="/schedules/@version.Id">開啟班表</a><a class="button-link" href="/download/schedules/@(version.Id).csv">下載 CSV</a>
                        @if (canEdit && !version.IsAdopted)
                        {
                            <button class="primary" disabled="@isBusy" @onclick="() => AdoptAsync(version)">採用</button>
                            <button class="danger" disabled="@isBusy" @onclick="() => ArchiveAsync(version)">封存</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (workspaceCode == WorkspaceCode.M)
{
    <section class="card">
        <div class="section-heading">
            <div>
                <h2>匯入歷史班表</h2>
                <p>指定月份後，上傳為一份可編輯的一般班表；不會自動採用或覆蓋既有版本。</p>
            </div>
            <div class="toolbar">
                <label>歷史月份<input type="month" value="@historyMonthText" @onchange="args => historyMonthText = args.Value?.ToString() ?? historyMonthText"/></label><a class="button-link" href="/download/templates/m/previous.csv">下載範本</a>
                @if (canEdit)
                {
                    <label class="button-link primary file-upload-button">上傳歷史班表<InputFile OnChange="ImportHistoryAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                }
            </div>
        </div>
    </section>
    <section class="card">
        <div class="section-heading">
            <div>
                <h2>M 全域萬年班表</h2>
                <p>固定 56 天週期；建立班表時可另外上傳該月份的暫用版本。</p>
            </div>
            <div class="toolbar">
                <a class="button-link" href="/download/templates/m/perpetual.csv">下載範本</a>
                @if (canEdit)
                {
                    <label class="button-link primary file-upload-button">上傳並覆蓋<InputFile OnChange="UploadPerpetualAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                }
            </div>
        </div>
        @if (perpetual is null)
        {
            <p>尚未建立全域萬年班表；仍可直接求解。</p>
        }
        else
        {
            <p>檔名：@perpetual.FileName　最後修改：@Taipei(perpetual.UpdatedAtUtc)</p>
            <div class="toolbar">
                <a class="button-link" target="_blank" href="/m/perpetual.csv">預覽 CSV</a><a class="button-link" href="/download/m/perpetual.csv">下載 CSV</a>
            </div>
            <div class="table-scroll schedule-grid">
                <table class="perpetual-table">
                    <thead>
                    <tr>
                        <th>萬年班表</th>
                        @for (var day = 1; day <= 56; day++)
                        {
                            <th>@day</th>
                        }
                        <th>早班數</th><th>小夜班數</th><th>夜班數</th><th>操作</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var pattern in patternEdits)
                    {
                        <tr>
                            <td>
                                <input class="inline-field perpetual-field" value="@pattern.Id" disabled="@(!canEdit || isBusy)" @onchange="args => RenamePatternAsync(pattern, args.Value?.ToString())"/>
                            </td>
                            @for (var day = 0; day < 56; day++)
                            {
                                var index = day;
                                <td>
                                    <select class="cell-editor" value="@pattern.Days[index]" disabled="@(!canEdit || isBusy)" @onchange="args => ChangePatternDayAsync(pattern, index, args.Value?.ToString())">
                                        <option value=""></option><option value="R">R</option>
                                        @foreach (var station in MStations)
                                        {
                                            <option value="@(station)早">@ShortStation(station)早</option>
                                            <option value="@(station)小">@ShortStation(station)小</option>
                                            <option value="@(station)夜">@ShortStation(station)夜</option>
                                        }
                                    </select>
                                </td>
                            }
                            <td>@CountShift(pattern, "早")</td><td>@CountShift(pattern, "小")</td><td>@CountShift(pattern, "夜")</td>
                            <td>
                                @if (canEdit)
                                {
                                    <button class="danger" disabled="@isBusy" @onclick="() => DeletePatternAsync(pattern)">刪除</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="toolbar">
                    <input class="inline-field" aria-label="新萬年班表代號" placeholder="新代號" @bind="newPatternId"/><button disabled="@(isBusy || string.IsNullOrWhiteSpace(newPatternId))" @onclick="AddPatternAsync">新增代號</button>
                </div>
            }
        }
    </section>
}
@if (workspaceCode == WorkspaceCode.T)
{
    <section class="card">
        <div class="section-heading">
            <div>
                <h2>匯入歷史班表</h2>
                <p>指定月份後，上傳為一份可編輯的一般班表；不會自動採用或覆蓋既有版本。</p>
            </div>
            <div class="toolbar">
                <label>歷史月份<input type="month" value="@historyMonthText" @onchange="args => historyMonthText = args.Value?.ToString() ?? historyMonthText"/></label><a class="button-link" href="/download/templates/t/previous.csv">下載範本</a>
                @if (canEdit)
                {
                    <label class="button-link primary file-upload-button">上傳歷史班表<InputFile OnChange="ImportHistoryAsync" accept=".csv,text/csv" disabled="@isBusy"/></label>
                }
            </div>
        </div>
    </section>
}


@code {
    [Parameter] public string Workspace { get; set; } = "";
    private WorkspaceCode workspaceCode;
    private bool canEdit;
    private IReadOnlyList<ScheduleMonthDto> months = [];
    private IReadOnlyList<ScheduleVersionDto> versions = [];
    private DateOnly? selectedMonth;
    private MPerpetualScheduleDto? perpetual;
    private List<PatternEdit> patternEdits = [];
    private string newPatternId = "";
    private string historyMonthText = DateTime.Today.ToString("yyyy-MM");
    private static readonly string[] MStations = ["LB01", "LB02", "LB03", "LB04", "LB05", "LB06", "LB07", "LB08", "LB09", "LB10", "LB11", "LB12"];
    private string? message;
    private string messageClass = "success";
    private bool isBusy;

    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<WorkspaceCode>(Workspace, true, out workspaceCode)) throw new DomainValidationException("工作區只支援 M 或 T。");
        var actor = await CurrentActor.GetAsync();
        canEdit = actor.CanEdit(workspaceCode) && !actor.MustChangePassword;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var actor = await CurrentActor.GetAsync();
        months = await Service.ListMonthsAsync(workspaceCode, actor);
        if (selectedMonth is null && months.Count > 0) selectedMonth = months[0].Month;
        versions = selectedMonth is null ? [] : await Service.ListVersionsAsync(workspaceCode, selectedMonth.Value, actor);
        if (workspaceCode == WorkspaceCode.M)
        {
            perpetual = await PerpetualService.GetAsync(actor);
            patternEdits = perpetual?.Patterns.Select(x => new PatternEdit(x.Id, x.Days.ToList())).ToList() ?? [];
        }
    }

    private async Task SelectMonthAsync(DateOnly month)
    {
        selectedMonth = month;
        versions = await Service.ListVersionsAsync(workspaceCode, month, await CurrentActor.GetAsync());
    }

    private Task AdoptAsync(ScheduleVersionDto version) => RunAsync(async () =>
    {
        await Service.AdoptAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "已採用這份班表。");

    private Task ArchiveAsync(ScheduleVersionDto version) => RunAsync(async () =>
    {
        await Service.ArchiveAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "班表已封存。");

    private Task ImportHistoryAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        if (!DateOnly.TryParse(historyMonthText + "-01", out var month)) throw new DomainValidationException("請選擇歷史月份。");
        if (workspaceCode == WorkspaceCode.M)
        {
            var bytes = await ReadFileAsync(args.File);
            await Service.ImportAsync(WorkspaceCode.M, month, args.File.Name, new MemoryStream(bytes), await CurrentActor.GetAsync());
            selectedMonth = month;
            await ReloadAsync();
        }
        else if (workspaceCode == WorkspaceCode.T)
        {
            var bytes = await ReadFileAsync(args.File);
            await Service.ImportAsync(WorkspaceCode.T, month, args.File.Name, new MemoryStream(bytes), await CurrentActor.GetAsync());
            selectedMonth = month;
            await ReloadAsync();
        }
        else
        {
            throw new DomainValidationException("工作區只支援 M 或 T。");
        }
    }, "歷史班表已匯入。");

    private Task UploadPerpetualAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        var bytes = await ReadFileAsync(args.File);
        perpetual = await PerpetualService.UploadAsync(args.File.Name, new MemoryStream(bytes), await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "全域萬年班表已覆蓋。");

    private Task ChangePatternDayAsync(PatternEdit pattern, int day, string? value)
    {
        pattern.Days[day] = value ?? "";
        return SavePatternAsync(pattern, pattern.Id);
    }

    private Task RenamePatternAsync(PatternEdit pattern, string? value) => SavePatternAsync(pattern, value ?? "");

    private Task SavePatternAsync(PatternEdit pattern, string id) => RunAsync(async () =>
    {
        perpetual = await PerpetualService.SavePatternAsync(pattern.OriginalId, id, pattern.Days, perpetual!.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "萬年班表已自動儲存。");

    private Task AddPatternAsync() => RunAsync(async () =>
    {
        perpetual = await PerpetualService.SavePatternAsync(null, newPatternId, Enumerable.Repeat("", 56).ToArray(), perpetual!.RevisionToken, await CurrentActor.GetAsync());
        newPatternId = "";
        await ReloadAsync();
    }, "已新增萬年班表代號。");

    private Task DeletePatternAsync(PatternEdit pattern) => RunAsync(async () =>
    {
        perpetual = await PerpetualService.DeletePatternAsync(pattern.OriginalId, perpetual!.RevisionToken, await CurrentActor.GetAsync());
        await ReloadAsync();
    }, "已刪除萬年班表代號。");

    private static IEnumerable<ObjectiveScoreDto> DisplayObjectives(ScheduleVersionDto version) => (version.Objectives ?? []).Where(score => version.Workspace == WorkspaceCode.M ? score.Priority is 1 or 4 : score.Priority is >= 1 and <= 5).OrderBy(score => score.Priority);

    private async Task RunAsync(Func<Task> action, string success)
    {
        isBusy = true;
        messageClass = "success";
        message = "處理中…";
        await InvokeAsync(StateHasChanged);
        try
        {
            await action();
            message = success;
        }
        catch (Exception exception)
        {
            messageClass = "error";
            message = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static async Task<byte[]> ReadFileAsync(IBrowserFile file)
    {
        await using var input = file.OpenReadStream(5 * 1024 * 1024);
        using var memory = new MemoryStream();
        await input.CopyToAsync(memory);
        return memory.ToArray();
    }

    private static int CountShift(PatternEdit pattern, string suffix) => pattern.Days.Count(x => x.EndsWith(suffix, StringComparison.Ordinal));
    private static string ShortStation(string station) => station.StartsWith("LB", StringComparison.Ordinal) ? station[2..] : station;
    private static string SourceText(ScheduleRunStatus status) => status switch { ScheduleRunStatus.Imported => "上傳", ScheduleRunStatus.TimeLimit => "求解（時限到）", ScheduleRunStatus.Optimal => "求解", _ => status.ToString() };
    private static string Taipei(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm");

    private sealed class PatternEdit(string id, List<string> days)
    {
        public string OriginalId { get; } = id;
        public string Id { get; set; } = id;
        public List<string> Days { get; } = days;
    }

}

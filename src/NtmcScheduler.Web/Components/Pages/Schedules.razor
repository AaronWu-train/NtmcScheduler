@page "/{Workspace}/schedules"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScheduleService Service
@inject CurrentActorService CurrentActor

<PageTitle>@workspaceCode 已排班表</PageTitle>
<div class="page-title"><div><h1>@workspaceCode 已排班表</h1><p>依月份管理所有求解或人工修改後的版本。</p></div><PageHelp Title="已排班表說明"><p>同月份可保存多份班表，但只能有一份 ★。紅色硬規則或 Coverage 違反必須先排除才能標星；黃色警示不阻擋。封存是軟刪除，歷史與稽核仍保留；目前 ★ 必須先改選其他版本。</p></PageHelp></div>
@if (message is not null) { <p class="alert @messageClass" role="status">@message</p> }
<div class="month-list">
@foreach (var month in months)
{
    <button class="month-card @(selectedMonth == month.Month ? "selected" : "")" @onclick="() => SelectMonthAsync(month.Month)"><strong>@month.Month.ToString("yyyy-MM")</strong><span>@month.VersionCount 份</span><span>@(month.Adopted is null ? "尚無 ★" : $"★ {month.Adopted.Name}")</span></button>
}
</div>
@if (selectedMonth is not null)
{
    <div class="table-scroll"><table><thead><tr><th>採用</th><th>名稱</th><th>來源狀態</th><th>建立時間</th><th>最後修改</th><th>警示</th><th>操作</th></tr></thead><tbody>
    @foreach (var version in versions)
    {
        <tr><td>@(version.IsAdopted ? "★" : "")</td><td><a href="/schedules/@version.Id">@version.Name</a></td><td>@version.SourceStatus</td><td>@Taipei(version.CreatedAtUtc)</td><td>@Taipei(version.UpdatedAtUtc)</td><td><span class="status @(version.HasErrors ? "error" : version.WarningCount > 0 ? "warning" : "ok")">@(version.HasErrors ? "紅色違規" : version.WarningCount > 0 ? $"黃色 {version.WarningCount}" : "通過")</span></td><td><a class="button-link" href="/download/schedules/@(version.Id).csv">下載 CSV</a>@if (canEdit) { <button disabled="@version.IsAdopted" @onclick="() => AdoptAsync(version)">標示 ★</button><button class="danger" disabled="@version.IsAdopted" @onclick="() => ArchiveAsync(version)">封存</button> }</td></tr>
    }
    </tbody></table></div>
}

@code {
    [Parameter] public string Workspace { get; set; } = "";
    private WorkspaceCode workspaceCode; private bool canEdit; private IReadOnlyList<ScheduleMonthDto> months = []; private IReadOnlyList<ScheduleVersionDto> versions = []; private DateOnly? selectedMonth;
    private string? message; private string messageClass = "success";
    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<WorkspaceCode>(Workspace, true, out workspaceCode)) throw new DomainValidationException("工作區只支援 M 或 T。");
        var actor = await CurrentActor.GetAsync(); canEdit = actor.CanEdit(workspaceCode) && !actor.MustChangePassword; await ReloadAsync();
    }
    private async Task ReloadAsync() { var actor = await CurrentActor.GetAsync(); months = await Service.ListMonthsAsync(workspaceCode, actor); if (selectedMonth is null && months.Count > 0) selectedMonth = months[0].Month; if (selectedMonth is not null) versions = await Service.ListVersionsAsync(workspaceCode, selectedMonth.Value, actor); }
    private async Task SelectMonthAsync(DateOnly month) { selectedMonth = month; versions = await Service.ListVersionsAsync(workspaceCode, month, await CurrentActor.GetAsync()); }
    private Task AdoptAsync(ScheduleVersionDto version) => RunAsync(async () => { await Service.AdoptAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync()); await ReloadAsync(); }, "已更新 ★ 採用版本。");
    private Task ArchiveAsync(ScheduleVersionDto version) => RunAsync(async () => { await Service.ArchiveAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync()); await ReloadAsync(); }, "班表已封存。");
    private async Task RunAsync(Func<Task> action, string success) { try { await action(); messageClass = "success"; message = success; } catch (Exception exception) { messageClass = "error"; message = exception.Message; } }
    private static string Taipei(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm");
}

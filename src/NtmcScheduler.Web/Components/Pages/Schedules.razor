@page "/{Workspace}/schedules"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScheduleService Service
@inject CurrentActorService CurrentActor

<PageTitle>@workspaceCode 班表列表</PageTitle>
<WorkspaceNav Workspace="@Workspace.ToLowerInvariant()" />
<div class="page-title"><div><h1>@workspaceCode 班表列表</h1><p>開啟、採用或封存每個月份的班表。</p></div><PageHelp Title="班表列表說明"><p>同月份可保存多份班表，但只能採用一份。所有硬規則必須先排除才能採用；目前採用的班表必須先改採用其他版本才能封存。</p></PageHelp></div>
@if (message is not null) { <p class="alert @messageClass" role="status">@message</p> }
<div class="month-list">
@foreach (var month in months)
{
    <button class="month-card @(selectedMonth == month.Month ? "selected" : "")" disabled="@isBusy" @onclick="() => SelectMonthAsync(month.Month)"><strong>@month.Month.ToString("yyyy-MM")</strong><span>@month.VersionCount 份班表</span><span>@(month.Adopted is null ? "尚未採用班表" : $"已採用：{month.Adopted.Name}")</span></button>
}
</div>
@if (selectedMonth is not null)
{
    <div class="table-scroll"><table><thead><tr><th>狀態</th><th>班表名稱</th><th>來源</th><th>最佳化分數</th><th>建立時間</th><th>最後修改</th><th>檢查結果</th><th>操作</th></tr></thead><tbody>
    @foreach (var version in versions)
    {
        <tr class="@(version.IsAdopted ? "adopted-row" : "")"><td>@if (version.IsAdopted) { <span class="adopted-badge">已採用</span> } else { <span>一般班表</span> }</td><td><a href="/schedules/@version.Id">@version.Name</a></td><td>@SourceText(version.SourceStatus)</td><td class="objective-scores">@foreach (var score in DisplayObjectives(version)) { <span>J@score.Priority：@score.Value</span> }@if (!DisplayObjectives(version).Any()) { <span>—</span> }</td><td>@Taipei(version.CreatedAtUtc)</td><td>@Taipei(version.UpdatedAtUtc)</td><td><span class="status @(version.HasErrors ? "warning" : version.WarningCount > 0 ? "warning" : "ok")">@(version.HasErrors ? "需要修正" : version.WarningCount > 0 ? $"建議 {version.WarningCount} 項" : "可採用")</span></td><td><a class="button-link" href="/schedules/@version.Id">開啟班表</a><a class="button-link" href="/download/schedules/@(version.Id).csv">下載 CSV</a>@if (canEdit && !version.IsAdopted) { <button class="primary" disabled="@isBusy" @onclick="() => AdoptAsync(version)">採用</button><button class="danger" disabled="@isBusy" @onclick="() => ArchiveAsync(version)">封存</button> }</td></tr>
    }
    </tbody></table></div>
}

@code {
    [Parameter] public string Workspace { get; set; } = "";
    private WorkspaceCode workspaceCode; private bool canEdit; private IReadOnlyList<ScheduleMonthDto> months = []; private IReadOnlyList<ScheduleVersionDto> versions = []; private DateOnly? selectedMonth;
    private string? message; private string messageClass = "success"; private bool isBusy;
    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<WorkspaceCode>(Workspace, true, out workspaceCode)) throw new DomainValidationException("工作區只支援 M 或 T。");
        var actor = await CurrentActor.GetAsync(); canEdit = actor.CanEdit(workspaceCode) && !actor.MustChangePassword; await ReloadAsync();
    }
    private async Task ReloadAsync() { var actor = await CurrentActor.GetAsync(); months = await Service.ListMonthsAsync(workspaceCode, actor); if (selectedMonth is null && months.Count > 0) selectedMonth = months[0].Month; if (selectedMonth is not null) versions = await Service.ListVersionsAsync(workspaceCode, selectedMonth.Value, actor); }
    private async Task SelectMonthAsync(DateOnly month) { selectedMonth = month; versions = await Service.ListVersionsAsync(workspaceCode, month, await CurrentActor.GetAsync()); }
    private Task AdoptAsync(ScheduleVersionDto version) => RunAsync(async () => { await Service.AdoptAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync()); await ReloadAsync(); }, "已採用這份班表。");
    private Task ArchiveAsync(ScheduleVersionDto version) => RunAsync(async () => { await Service.ArchiveAsync(version.Id, version.RevisionToken, await CurrentActor.GetAsync()); await ReloadAsync(); }, "班表已封存。");
    private static IEnumerable<ObjectiveScoreDto> DisplayObjectives(ScheduleVersionDto version) => (version.Objectives ?? []).Where(score => version.Workspace == WorkspaceCode.M ? score.Priority is 1 or 4 : score.Priority is >= 1 and <= 5).OrderBy(score => score.Priority);
    private async Task RunAsync(Func<Task> action, string success) { isBusy = true; messageClass = "success"; message = "處理中…"; await InvokeAsync(StateHasChanged); try { await action(); message = success; } catch (Exception exception) { messageClass = "error"; message = exception.Message; } finally { isBusy = false; } }
    private static string SourceText(ScheduleRunStatus status) => status switch { ScheduleRunStatus.Imported => "上傳", ScheduleRunStatus.TimeLimit => "求解（時限到）", ScheduleRunStatus.Optimal => "求解", _ => status.ToString() };
    private static string Taipei(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm");
}

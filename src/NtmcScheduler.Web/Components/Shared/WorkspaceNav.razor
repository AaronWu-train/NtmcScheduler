@inject CurrentActorService CurrentActor

@if (Workspace is "m" or "t")
{
    <aside class="workspace-nav" aria-label="@Workspace.ToUpperInvariant() 工作區功能">
        <strong>@Workspace.ToUpperInvariant() 工作區</strong>
        <NavLink href="@($"/{Workspace}/employees")">編輯員工資料</NavLink>
        <NavLink href="@($"/{Workspace}/schedules")">班表列表</NavLink>
        @if (Workspace == "m")
        {
            <NavLink href="/m/perpetual">萬年班表</NavLink>
        }
        @if (canCreateSchedule)
        {
            <NavLink href="@($"/{Workspace}/demand")">求解新班表</NavLink>
            <NavLink href="@($"/{Workspace}/shift-times")">班別時間設定</NavLink>
        }
    </aside>
}

@code {
    [Parameter] public string Workspace { get; set; } = "";
    private bool canCreateSchedule;

    protected override async Task OnParametersSetAsync()
    {
        canCreateSchedule = Enum.TryParse<WorkspaceCode>(Workspace, true, out var workspace)
            && (await CurrentActor.GetAsync()).CanEdit(workspace);
    }
}

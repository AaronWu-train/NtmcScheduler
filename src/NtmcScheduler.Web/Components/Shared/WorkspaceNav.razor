@inject CurrentActorService CurrentActor

@if (workspaceCode is not null)
{
    <aside class="workspace-nav" aria-label="@workspaceCode.Value.DisplayName() 工作區功能">
        <strong>@workspaceCode.Value.DisplayName()</strong>
        <NavLink href="@($"/{Workspace}/employees")">編輯員工資料</NavLink>
        <NavLink href="@($"/{Workspace}/schedules")">班表列表</NavLink>
        @if (workspaceCode.Value.IsStation())
        {
            <NavLink href="@($"/{Workspace}/perpetual")">萬年班表</NavLink>
        }
        @if (canCreateSchedule)
        {
            <NavLink href="@($"/{Workspace}/demand")">求解新班表</NavLink>
            <NavLink href="@($"/{Workspace}/shift-times")">班別時間設定</NavLink>
        }
    </aside>
}

@code {
    [Parameter] public string Workspace { get; set; } = "";
    private WorkspaceCode? workspaceCode;
    private bool canCreateSchedule;

    protected override async Task OnParametersSetAsync()
    {
        workspaceCode = Enum.TryParse<WorkspaceCode>(Workspace, true, out var workspace) ? workspace : null;
        canCreateSchedule = workspaceCode is { } code && (await CurrentActor.GetAsync()).CanEdit(code);
    }
}
